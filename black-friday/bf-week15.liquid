{%- comment -%}
  Black Friday week pop-up: 15% off orders over 25 pounds with code BFWEEK15 (not valid on sale items, one use per customer).
  The code shows after the visitor gives an email address, which goes to Klaviyo (list: Black Friday week 15% sign-ups, id XqJekh).
  UK, Ireland, Germany and the US, each in its own currency and language. Runs until Monday 30 November 2026, 23:59 UK time.
  Shows 20 seconds after the page loads, once per visitor (a closed pop-up stays away for 3 days). Not on the cart page.
  Add ?bf15=test to any address to see it at once.
{%- endcomment -%}
{%- unless request.page_type == 'cart' -%}
{%- assign mk = localization.country.iso_code -%}
{%- if mk == 'DE' -%}
  {%- assign t_kick = 'Black-Friday-Woche' -%}
  {%- assign t_a = '15 %' -%}{%- assign t_b = ' Rabatt ab ' -%}{%- assign t_c = '30 €' -%}{%- assign t_d = '' -%}
  {%- assign t_sub = 'Ein Code für alles, was nicht schon reduziert ist. Gültig bis Montag, 30. November.' -%}
  {%- assign t_ask = 'Tragen Sie Ihre E-Mail-Adresse ein und wir zeigen Ihnen sofort Ihren Code.' -%}{%- assign t_label = 'Ihre E-Mail-Adresse' -%}{%- assign t_go = 'Code anzeigen' -%}{%- assign t_err = 'Bitte geben Sie eine gültige E-Mail-Adresse ein.' -%}{%- assign t_ok = 'Hier ist Ihr Code. Gültig bis Montag, 30. November.' -%}{%- assign t_consent = 'Mit dem Absenden stimmen Sie zu, E-Mails von Poorly Pet zu erhalten. Abmeldung jederzeit möglich.' -%}
  {%- assign t_copy = 'Kopieren' -%}{%- assign t_copied = 'Kopiert' -%}{%- assign t_shop = 'Jetzt einkaufen' -%}{%- assign t_close = 'Schließen' -%}
  {%- assign t_fine = 'Ab 30 € Bestellwert. Einmal pro Kunde. Nicht gültig für reduzierte Artikel.' -%}
{%- else -%}
  {%- assign t_kick = 'Black Friday week' -%}
  {%- assign t_a = '15%' -%}{%- assign t_b = ' off when you spend ' -%}{%- assign t_d = '' -%}
  {%- if mk == 'US' -%}{%- assign t_c = '$35' -%}{%- elsif mk == 'IE' -%}{%- assign t_c = '€30' -%}{%- else -%}{%- assign t_c = '£25' -%}{%- endif -%}
