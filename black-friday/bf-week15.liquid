.bfw-sub{margin:0 0 18px;font:400 16px/1.5 Figtree,Arial,sans-serif;color:#d4e2df}
.bfw-code{display:flex;align-items:center;justify-content:space-between;gap:10px;border-radius:10px;padding:8px 8px 8px 18px;background:#fff}
.bfw-code b{font:700 24px/1 Domine,Georgia,serif;color:#0F4C48;letter-spacing:.04em}
.bfw-btn{display:flex;align-items:center;justify-content:center;min-height:52px;padding:0 20px;border:0;border-radius:8px;background:#DFE43A;color:#0F4C48;font:600 16px/1.2 Figtree,Arial,sans-serif;text-decoration:none;cursor:pointer}
.bfw-btn:hover{background:#D2D82C}
.bfw-copy{min-height:40px;padding:0 16px;font-size:14px;background:#0F4C48;color:#fff}
.bfw-copy:hover{background:#0A3A37}
.bfw-go{width:100%;margin-top:10px}
.bfw-fine{margin:12px 0 0;font:400 11px/1.45 Figtree,Arial,sans-serif;color:#9fb8b3}
.bfw-fm{display:grid;gap:10px}
.bfw-fm input{height:52px;border:0;border-radius:8px;padding:0 16px;font:400 16px Figtree,Arial,sans-serif;color:#0E2A28;background:#fff;width:100%}
.bfw-fm input[aria-invalid=true]{outline:2px solid #F0614A}
.bfw-fm .bfw-btn{width:100%}
.bfw-err{display:none;margin:0;font:400 13px/1.4 Figtree,Arial,sans-serif;color:#ffd2c9}
.bfw-err.on{display:block}
.bfw-ok{display:none}
.bfw-bd.sent .bfw-form{display:none}
.bfw-bd.sent .bfw-ok{display:block}
@media (max-width:620px){
  .bfw-card{grid-template-columns:1fr;width:min(360px,100%);text-align:center}
  .bfw-ph{display:none}
  .bfw-bd{padding:34px 20px 20px}
  .bfw-kick{margin-bottom:10px;font-size:12px}
  .bfw h2{font-size:27px;margin-bottom:10px}
  .bfw-sub{font-size:15px;margin-bottom:14px}
  .bfw-fm input,.bfw-btn{min-height:48px;height:48px}
  .bfw-code{padding:6px 6px 6px 14px}.bfw-code b{font-size:20px}
  .bfw-x{top:8px;right:8px;width:32px;height:32px;font-size:22px}
}
@media (prefers-reduced-motion:reduce){.bfw *{transition-duration:.01ms!important}}
</style>
<div class="bfw" id="bfw" role="dialog" aria-modal="true" aria-labelledby="bfw-h" hidden>
  <div class="bfw-scrim" data-bfw-close></div>
  <div class="bfw-card" tabindex="-1">
    <button class="bfw-x" type="button" aria-label="{{ t_close }}" data-bfw-close>&times;</button>
    <div class="bfw-bd">
      <p class="bfw-kick">{{ t_kick }}</p>
      <h2 id="bfw-h"><span class="bfw-p bfw-l">{{ t_a }}</span>{{ t_b }}<span class="bfw-p bfw-c">{{ t_c }}</span>{{ t_d }}</h2>
      <div class="bfw-form">
        <p class="bfw-sub">{{ t_ask }}</p>
        <form class="bfw-fm" id="bfw-form" novalidate onsubmit="return false">
          <label for="bfw-email" style="position:absolute;left:-9999px">{{ t_label }}</label>
          <input type="email" id="bfw-email" placeholder="{{ t_label | escape }}" autocomplete="email">
          <p class="bfw-err" id="bfw-err">{{ t_err }}</p>
          <button class="bfw-btn" type="submit" id="bfw-go">{{ t_go }}</button>
        </form>
        <p class="bfw-fine">{{ t_consent }} {{ t_fine }}</p>
      </div>
      <div class="bfw-ok">
        <p class="bfw-sub">{{ t_ok }}</p>
        <div class="bfw-code"><b id="bfw-code">BFWEEK15</b><button class="bfw-btn bfw-copy" type="button" id="bfw-copy">{{ t_copy }}</button></div>
        <a class="bfw-btn bfw-go" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}discount/BFWEEK15?redirect={{ routes.all_products_collection_url | url_encode }}">{{ t_shop }}</a>
        <p class="bfw-fine">{{ t_fine }}</p>
      </div>
    </div>
    <div class="bfw-ph" role="img" aria-label=""></div>
  </div>
</div>
<script>
(function () {
  if (window.top !== window.self) return;
  var KEY = 'pp_bfw15', END = Date.UTC(2026, 10, 30, 23, 59, 59);
  var el = document.getElementById('bfw'); if (!el) return;
  var q = new URLSearchParams(location.search), tst = q.get('bf15') === 'test', now = Date.now();
  if (!tst && now > END) return;
  if (tst) { try { localStorage.removeItem(KEY); } catch (e) {} }
  try { var v = JSON.parse(localStorage.getItem(KEY) || 'null'); if (v && now - v.t < 3 * 864e5) return; } catch (e) {}
  var shown = false, last = null, card = el.querySelector('.bfw-card');
  function open() {
    if (shown) return; shown = true; last = document.activeElement;
    el.hidden = false; el.classList.add('on');
    requestAnimationFrame(function () { requestAnimationFrame(function () { el.classList.add('in'); card.focus({ preventScroll: true }); }); });
  }
  function close() {
    el.classList.remove('in'); setTimeout(function () { el.classList.remove('on'); el.hidden = true; }, 350);
    try { localStorage.setItem(KEY, JSON.stringify({ t: Date.now() })); } catch (e) {}
    if (last && last.focus) try { last.focus(); } catch (e) {}
  }
  [].forEach.call(el.querySelectorAll('[data-bfw-close]'), function (b) { b.addEventListener('click', close); });
  document.addEventListener('keydown', function (e) {
    if (!shown || !el.classList.contains('on')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'Tab') {
      var f = [].filter.call(el.querySelectorAll('button,a[href],input'), function (n) { return n.offsetParent !== null; });
      if (!f.length) return; var a = f[0], z = f[f.length - 1];
      if (e.shiftKey && (document.activeElement === a || document.activeElement === card)) { e.preventDefault(); z.focus(); }
      else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); }
    }
  });
  setTimeout(open, tst ? 600 : 20000);
  var bd = el.querySelector('.bfw-bd'), em = document.getElementById('bfw-email'), er = document.getElementById('bfw-err');
  try { var dn = JSON.parse(localStorage.getItem(KEY + '_done') || 'null'); if (dn) bd.classList.add('sent'); } catch (e) {}
  em.addEventListener('input', function () { em.removeAttribute('aria-invalid'); er.classList.remove('on'); });
  document.getElementById('bfw-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var v = em.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) { em.setAttribute('aria-invalid', 'true'); er.classList.add('on'); em.focus(); return; }
    document.getElementById('bfw-go').disabled = true;
    try {
      fetch('https://a.klaviyo.com/client/subscriptions/?company_id=UU3NF7', {
        method: 'POST', keepalive: true,
        headers: { 'Content-Type': 'application/vnd.api+json', 'revision': '2024-10-15' },
        body: JSON.stringify({ data: { type: 'subscription', attributes: { custom_source: 'Black Friday week 15% pop-up',
          profile: { data: { type: 'profile', attributes: { email: v, properties: { source: 'bfweek15-popup', market: {{ mk | default: 'GB' | json }}, voucher: 'BFWEEK15' } } } } },
          relationships: { list: { data: { type: 'list', id: 'XqJekh' } } } } })
      }).catch(function () {});
    } catch (x) {}
    setTimeout(function () { try { localStorage.setItem(KEY + '_done', '1'); } catch (x) {} bd.classList.add('sent'); }, 350);
  });
  document.getElementById('bfw-copy').addEventListener('click', function () {
    var b = this;
    function done() { b.textContent = {{ t_copied | json }}; setTimeout(function () { b.textContent = {{ t_copy | json }}; }, 1800); }
    if (navigator.clipboard) navigator.clipboard.writeText('BFWEEK15').then(done, done); else done();
  });
})();
</script>
{%- endunless -%}
