<section class="lfit"><div class="wrap">{% render 'sec-head', heading: section.settings.heading, text: section.settings.text %}</div>
<div class="lsplit">
  {%- for block in section.blocks limit: 3 -%}
    {%- liquid
      assign from = block.settings.collection.products | map: 'price' | sort | first
    -%}
    <a class="lp" href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>{% render 'ph', image: block.settings.image, note: block.settings.note, cls: 'fill', sizes: '(min-width: 990px) 33vw, 100vw' %}<small>{{ block.settings.label }}</small><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p><div class="row">{%- if from -%}{%- assign fp = from | money_without_trailing_zeros -%}<b>{{ 'collection.from' | t: price: fp }}</b>{%- endif -%}<span class="btn wh">{{ block.settings.cta }}</span></div></a>
  {%- endfor -%}
</div></section>
{% schema %}
{
  "name": "Shop your level",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop your level" },
    { "type": "text", "id": "text", "label": "Text", "default": "Every racket we stock is matched to a level of player." }
  ],
  "blocks": [ { "type": "level", "name": "Level", "limit": 3, "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "note", "label": "Placeholder note" },
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta", "label": "Button" } ] } ],
  "presets": [ { "name": "Shop your level" } ]
}
{% endschema %}
