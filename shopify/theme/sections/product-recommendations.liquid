<div class="wrap"><section class="psec">
  {% render 'sec-head', heading: section.settings.heading, text: section.settings.text %}
  <div class="grid" data-recs="{{ product.id }}" data-section="{{ section.id }}" data-limit="4">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- for p in recommendations.products -%}{% render 'product-card', product: p %}{%- endfor -%}
    {%- endif -%}
  </div>
</section></div>
{% schema %}
{
  "name": "You may also like",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "text", "id": "text", "label": "Text", "default": "More from the brands we stock." }
  ]
}
{% endschema %}
