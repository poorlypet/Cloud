{%- assign col = section.settings.collection -%}
<section class="sec {{ section.settings.cls }}"><div class="wrap">
  {% render 'sec-head', heading: section.settings.heading, text: section.settings.text, link_label: section.settings.link_label, link: col.url %}
  <div class="begin">
    <div class="intro">
      <div class="ph bph">{% render 'ph', image: section.settings.image, note: section.settings.note, cls: 'fill', sizes: '(min-width: 990px) 25vw, 100vw' %}</div>
      <div><h3>{{ section.settings.intro_heading }}</h3><p>{{ section.settings.intro_text }}</p></div>
      {%- if section.settings.button_label != blank -%}<div class="ia"><a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>{%- endif -%}
    </div>
    <div class="grid">
      {%- for p in col.products limit: 3 -%}{% render 'product-card', product: p %}{%- endfor -%}
    </div>
  </div>
</div></section>
{% schema %}
{
  "name": "Beginners",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best for beginners" },
    { "type": "text", "id": "text", "label": "Text", "default": "Forgiving rackets picked for your first year on court." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Shop beginner rackets" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "note", "label": "Placeholder note", "default": "beginner on court, first lesson" },
    { "type": "text", "id": "intro_heading", "label": "Card heading", "default": "New to padel?" },
    { "type": "textarea", "id": "intro_text", "label": "Card text", "default": "Start with a round racket. The sweet spot is bigger, the core is softer and it is far easier to control while you learn." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Read our first racket guide" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "cls", "label": "Spacing class", "default": "t0" }
  ],
  "presets": [ { "name": "Beginners" } ]
}
{% endschema %}
