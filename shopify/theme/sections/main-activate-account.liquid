<div class="pg sx pg-signin v2"><section class="sec sx-sec pt8 sic"><div class="wrap"><div class="acc2b">
  <div class="pane on"><h1>{{ 'account.activate_account' | t }}</h1>
  {%- form 'activate_customer_password', class: 'tfx' -%}
    {%- if form.errors -%}<p class="ferr">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label>{{ 'account.password' | t }}<input type="password" name="customer[password]" required autocomplete="new-password"></label>
    <label>{{ 'account.password_confirm' | t }}<input type="password" name="customer[password_confirmation]" required autocomplete="new-password"></label>
    <button class="btn hor" type="submit">{{ 'account.save' | t }}</button>
  {%- endform -%}
  </div>
</div></div></section></div>
{% schema %}
{ "name": "Password" }
{% endschema %}
