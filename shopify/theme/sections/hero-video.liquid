<section class="hero"><div class="wrap">
  <div class="box">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'vid', image_size: '1600x' }}
    {%- elsif section.settings.video_url != blank -%}
      <video class="vid" autoplay muted loop playsinline {% if section.settings.poster %}poster="{{ section.settings.poster | image_url: width: 1800 }}"{% endif %} src="{{ section.settings.video_url }}"></video>
    {%- elsif section.settings.poster != blank -%}
      {{ section.settings.poster | image_url: width: 2000 | image_tag: class: 'vid', widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: '' }}
    {%- endif -%}
    <div class="in"><h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.button_label != blank -%}<div class="hb"><a class="btn hor" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>{%- endif -%}
    </div>
  </div>
  <div class="tbar"><span style="display:inline-flex;gap:10px;align-items:center">
    {%- if settings.tp_label != blank -%}<b>{{ settings.tp_label }}</b>{% render 'stars' %}<span>{{ settings.tp_score }} out of 5</span>{% render 'icon', name: 'tp' %}<span class="tbn">{{ settings.tp_score }}</span><span class="tbc">{{ settings.tp_count }} reviews on</span>{%- elsif request.design_mode -%}<b>Excellent</b>{% render 'stars' %}<span>4.8 out of 5</span><span class="tbc">126 reviews on</span>{% render 'icon', name: 'tp' %}{%- endif -%}
  </span>{%- if settings.delivery_line != blank -%}<span>{{ settings.delivery_line }}</span>{%- endif -%}</div>
  {%- if section.blocks.size > 0 -%}
  <div class="three" style="grid-template-columns:repeat({{ section.blocks.size }},minmax(0,1fr))">
    {%- for block in section.blocks -%}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}{% render 'icon', name: 'arrow' %}</a>{%- endfor -%}
  </div>
  {%- endif -%}
</div></section>
{% schema %}
{
  "name": "Hero video",
  "settings": [
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "url", "id": "video_url", "label": "Or video file link (.mp4)" },
    { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Shown while the video loads, or on its own." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Europe's best padel brands, in one store" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "SHOP THE SALE" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [ { "type": "link", "name": "Category link", "limit": 4, "settings": [
    { "type": "text", "id": "label", "label": "Label" }, { "type": "url", "id": "link", "label": "Link" } ] } ],
  "presets": [ { "name": "Hero video" } ]
}
{% endschema %}
