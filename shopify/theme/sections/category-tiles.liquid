<section class="sec{% if section.settings.page_style %} sx-sec{% endif %} {{ section.settings.cls }}"><div class="wrap">
  {%- if section.settings.heading != blank -%}{% render 'sec-head', heading: section.settings.heading, text: section.settings.text %}{%- endif -%}
  <div class="ctiles c{{ section.blocks.size | at_most: 4 }}{% if section.settings.page_style %} sxt{% endif %}">
    {%- for block in section.blocks -%}
      <a class="ct ca" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% render 'ph', image: block.settings.image, note: block.settings.note, cls: 'fill', sizes: '(min-width: 990px) 25vw, 50vw' %}{%- if section.settings.page_style -%}<span class="cap"><b>{{ block.settings.label }}</b>{%- if block.settings.sub != blank -%}<span>{{ block.settings.sub }}</span>{%- endif -%}</span>{%- else -%}<b>{{ block.settings.label }}</b>{%- endif -%}<span class="arw">{% render 'icon', name: 'arrow' %}</span></a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "cls", "label": "Spacing class", "info": "Leave empty. t0 removes the top space." },
    { "type": "checkbox", "id": "page_style", "label": "Store page style", "default": false }
  ],
  "blocks": [ { "type": "tile", "name": "Tile", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "note", "label": "Placeholder note" },
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "sub", "label": "Small text" },
    { "type": "url", "id": "link", "label": "Link" } ] } ],
  "presets": [ { "name": "Category tiles" } ]
}
{% endschema %}
