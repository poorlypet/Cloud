{%- assign s = section.settings -%}
<div class="pg sx pg-guide v1">
<div class="wrap">{% render 'crumbs', title: blog.title %}</div>
<section class="sxh sm"><div class="wrap"><div class="fbox">
  <div class="pph fill">{% render 'ph', image: s.image, note: s.note, cls: 'fill' %}</div>
  <div class="in"><div class="tx"><small>{{ blog.title }}</small><h1>{{ s.heading }}</h1><p>{{ s.text }}</p>
    <form class="sxs" action="{{ routes.search_url }}" method="get"><input type="hidden" name="type" value="article"><input name="q" placeholder="{{ 'blog.search' | t }}" aria-label="{{ 'blog.search' | t }}"><button class="btn hor" type="submit">{{ 'search.button' | t }}</button></form>
  </div></div>
</div></div></section>
{%- if blog.all_tags.size > 0 -%}
<section class="sec sx-sec pt0"><div class="wrap"><div class="gcat5">
  {%- for tag in blog.all_tags limit: 5 -%}<a href="{{ blog.url }}/tagged/{{ tag | handleize }}"{% if current_tags contains tag %} class="on"{% endif %}><span class="note">{{ 'general.photo' | t }}: {{ tag }}</span><span><b>{{ tag }}</b></span></a>{%- endfor -%}
</div></div></section>
{%- endif -%}
{%- paginate blog.articles by 12 -%}
<section class="sec sx-sec"><div class="wrap">
  <div class="sh"><div class="shl"><h2>{%- if current_tags -%}{{ current_tags.first }}{%- else -%}{{ 'blog.latest' | t }}{%- endif -%}</h2></div></div>
  <div class="gcards c4">
    {%- for article in blog.articles -%}
      <a class="gcd" href="{{ article.url }}"><div class="pph gp">{% render 'ph', image: article.image, note: article.title, cls: 'fill', sizes: '(min-width: 990px) 25vw, 50vw' %}</div><span class="gtg">{{ article.tags.first }}</span><h3>{{ article.title }}</h3><span class="gm">{% render 'read-time', article: article %}</span></a>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<nav class="pgn">{%- for part in paginate.parts -%}{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="{% if part.title == paginate.current_page %}on{% endif %}">{{ part.title }}</span>{%- endif -%}{%- endfor -%}</nav>{%- endif -%}
</div></section>
{%- endpaginate -%}
{%- assign col = s.collection -%}
{%- if col.products.size > 0 -%}
<section class="sec sx-sec"><div class="wrap">{% render 'sec-head', heading: s.products_heading, text: s.products_text, link_label: s.link_label, link: col.url %}<div class="grid">{%- for p in col.products limit: 4 -%}{% render 'product-card', product: p %}{%- endfor -%}</div></div></section>
{%- endif -%}
</div>
{% schema %}
{
  "name": "Guides",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "note", "label": "Placeholder note", "default": "player hitting a bandeja at the net" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Play better. Buy smarter." },
    { "type": "text", "id": "text", "label": "Text", "default": "Buying advice, technique and kit care from players who know the game." },
    { "type": "collection", "id": "collection", "label": "Products from" },
    { "type": "text", "id": "products_heading", "label": "Products heading", "default": "Shop rackets" },
    { "type": "text", "id": "products_text", "label": "Products text", "default": "Picked by the team who write the guides." },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Shop all rackets" }
  ]
}
{% endschema %}
