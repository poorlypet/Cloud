{%- liquid
  assign s = section.settings
  assign found = false
  if search.performed and search.results_count > 0
    assign found = true
  endif
-%}
{%- if found -%}
<div data-plp="{{ section.id }}">
<div class="wrap">
  {%- capture st -%}{{ 'search.label' | t }}{%- endcapture -%}
  {% render 'crumbs', title: st %}
  <section class="srhd s1"><div class="srt"><h1>{{ 'search.results_for_html' | t: count: search.results_count, terms: search.terms }}</h1></div></section>
  <div class="ptrust t2">{%- if settings.tp_label != blank -%}<span>{% render 'stars', size: 's' %}<b>{{ settings.tp_label }}</b> on Trustpilot</span>{%- endif -%}{%- if settings.klarna -%}<span>{{ 'general.pay_in_3' | t }}</span>{%- endif -%}</div>
  {%- paginate search.results by 24 -%}
  <div class="plp top"><div>
    {% render 'facets', results: search, url: routes.search_url, form_id: 'ff', sheet: false %}
    <div class="tool" id="tool"><span class="count" id="cnt"><b>{{ search.results_count }}</b> {{ 'search.products' | t }}</span><div class="r">
      <button class="fbtn" type="button" data-open-f>{% render 'icon', name: 'filter' %}{{ 'collection.filter' | t }}</button>
      <label class="sel srt"><span class="slx">{{ 'collection.sort' | t }}</span><select id="sort" name="sort_by" aria-label="{{ 'collection.sort' | t }}">
        {%- assign sb = search.sort_by | default: search.default_sort_by -%}
        {%- for o in search.sort_options -%}<option value="{{ o.value }}"{% if o.value == sb %} selected{% endif %}>{{ o.name }}</option>{%- endfor -%}
      </select></label>
    </div></div>
    {% render 'active-filters', results: search, url: routes.search_url %}
    <div class="pgrid c4" id="pgrid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'product-card', product: item, wrap: true %}
        {%- else -%}<a class="pc srx" href="{{ item.url }}"><div class="card"><div class="meta"><div class="br">{{ item.object_type | capitalize }}</div><div>{{ item.title }}</div></div></div></a>{%- endif -%}
      {%- endfor -%}
    </div>
    <div class="more" id="more">{%- if paginate.next -%}<div class="mbox"><button class="btn" type="button" data-loadmore="{{ paginate.next.url }}">{{ 'search.more' | t }}</button></div>{%- endif -%}</div>
  </div></div>
  {%- endpaginate -%}
</div>
{% render 'facets', results: search, url: routes.search_url, form_id: 'ff2', sheet: true %}
</div>
{%- else -%}
<div class="pg sx pg-noresults v1">
  <section class="nrh"><div class="wrap">
    <form class="srbig2" action="{{ routes.search_url }}" method="get" role="search"><input name="q" value="{{ search.terms | escape }}" aria-label="{{ 'search.label' | t }}" placeholder="{{ 'search.placeholder' | t }}"><button class="btn hor" type="submit">{{ 'search.button' | t }}</button></form>
    {%- if search.performed -%}<h1>{{ 'search.none_html' | t: terms: search.terms }}</h1><p>{{ 'search.none_text' | t }}</p>{%- else -%}<h1>{{ 'search.label' | t }}</h1>{%- endif -%}
  </div></section>
  {%- if section.blocks.size > 0 -%}
  <section class="sec sx-sec pt0"><div class="wrap"><div class="ctiles c4 sxt">
    {%- for block in section.blocks -%}<a class="ct ca" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% render 'ph', image: block.settings.image, note: block.settings.note, cls: 'fill', sizes: '25vw' %}<span class="cap"><b>{{ block.settings.label }}</b></span><span class="arw">{% render 'icon', name: 'arrow' %}</span></a>{%- endfor -%}
  </div></div></section>
  {%- endif -%}
  {%- assign col = s.collection -%}
  {%- if col.products.size > 0 -%}
  <section class="sec sx-sec"><div class="wrap">{% render 'sec-head', heading: s.heading, link_label: s.link_label, link: col.url %}<div class="grid">{%- for p in col.products limit: 4 -%}{% render 'product-card', product: p %}{%- endfor -%}</div></div></section>
  {%- endif -%}
</div>
{%- endif -%}
{% schema %}
{
  "name": "Search",
  "settings": [
    { "type": "text", "id": "heading", "label": "No results: product heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "No results: products from" },
    { "type": "text", "id": "link_label", "label": "No results: link text", "default": "Shop rackets" }
  ],
  "blocks": [ { "type": "tile", "name": "No results tile", "limit": 4, "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "note", "label": "Placeholder note" },
    { "type": "text", "id": "label", "label": "Label" }, { "type": "url", "id": "link", "label": "Link" } ] } ]
}
{% endschema %}
