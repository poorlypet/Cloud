{%- assign s = section.settings -%}
{%- assign ct = page.title | default: s.heading -%}
{%- if s.crumbs -%}<div class="wrap">{% render 'crumbs', title: ct, parent_title: s.parent_label, parent_url: s.parent_link %}</div>{%- endif -%}
<section class="sxh {{ s.size }}"><div class="wrap"><div class="fbox">
  <div class="pph fill">{% render 'ph', image: s.image, note: s.note, cls: 'fill' %}</div>
  <div class="in"><div class="tx"><small>{{ s.label | default: page.title }}</small><h1>{{ s.heading | default: page.title }}</h1>{%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
    {%- if s.button_label != blank -%}<div class="ia"><a class="btn hor" href="{{ s.button_link }}">{{ s.button_label }}</a></div>{%- endif -%}
  </div></div>
</div></div></section>
{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "checkbox", "id": "crumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "parent_label", "label": "Breadcrumb parent", "default": "Help" },
    { "type": "url", "id": "parent_link", "label": "Breadcrumb parent link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "note", "label": "Placeholder note" },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "size", "label": "Height", "default": "one", "options": [ { "value": "one", "label": "Tall" }, { "value": "sm", "label": "Short" } ] }
  ],
  "presets": [ { "name": "Page hero" } ]
}
{% endschema %}
