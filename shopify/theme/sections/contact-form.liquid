{%- assign s = section.settings -%}
<div class="pg sx pg-contact v2">
<div class="wrap">{% render 'crumbs', title: page.title, parent_title: s.parent_label, parent_url: s.parent_link %}</div>
<section class="sec sx-sec pt0"><div class="wrap"><div class="ct2">
  <div class="l"><small>{{ s.label }}</small><h1>{{ s.heading }}</h1><p>{{ s.text }}</p>
    <div class="routes">{%- for block in section.blocks -%}<div {{ block.shopify_attributes }}><span><b>{{ block.settings.title }}</b><small>{{ block.settings.text }}</small></span></div>{%- endfor -%}</div>
    <div class="pph ctp">{% render 'ph', image: s.image, note: s.note, cls: 'fill', sizes: '40vw' %}</div>
  </div>
  {%- form 'contact', class: 'sxform-f' -%}
  <div class="sxform grey" id="cform">
    <h2>{{ s.form_heading }}</h2><p>{{ s.form_text }}</p>
    {%- if form.posted_successfully? -%}<div class="ok" style="display:block"><b>{{ 'contact.thanks' | t }}</b> {{ 'contact.reply' | t }}</div>{%- else -%}
    {%- if form.errors -%}<p class="ferr">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="two"><label>{{ 'contact.name' | t }}<input name="contact[name]" required autocomplete="name"></label><label>{{ 'contact.email' | t }}<input type="email" name="contact[email]" required autocomplete="email"></label></div>
    <label>{{ 'contact.topic' | t }}<select name="contact[topic]">{%- assign topics = s.topics | split: ',' -%}{%- for t in topics -%}<option>{{ t | strip }}</option>{%- endfor -%}</select></label>
    <label>{{ 'contact.order' | t }}<input name="contact[order]" placeholder="{{ s.order_placeholder }}"></label>
    <label>{{ 'contact.message' | t }}<textarea name="contact[body]" rows="5" required></textarea></label>
    <button class="btn hor" type="submit">{{ 'contact.send' | t }}</button>
    {%- endif -%}
  </div>
  {%- endform -%}
</div></div></section>
</div>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "parent_label", "label": "Breadcrumb parent", "default": "Help" },
    { "type": "url", "id": "parent_link", "label": "Breadcrumb parent link" },
    { "type": "text", "id": "label", "label": "Small label", "default": "Contact us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to a player, not a script." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Our team play padel too. Ask us about an order, a return or which racket suits your game." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "note", "label": "Placeholder note", "default": "our team in the warehouse" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "text", "id": "form_text", "label": "Form text", "default": "We usually reply within one working day." },
    { "type": "text", "id": "topics", "label": "Topics", "default": "An order I have placed, A return or refund, Choosing a racket or kit, Something else" },
    { "type": "text", "id": "order_placeholder", "label": "Order number example", "default": "For example #1001" }
  ],
  "blocks": [ { "type": "route", "name": "Contact route", "limit": 4, "settings": [
    { "type": "text", "id": "title", "label": "Title" }, { "type": "text", "id": "text", "label": "Detail" } ] } ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
