<div class="pg sx pg-notfound v3">
<section class="sec sx-sec pt8"><div class="wrap"><div class="nf3">
  <div class="sb"><div><small>Set</small><b>4</b></div><div><small>Games</small><b>0</b></div><div><small>Points</small><b>4</b></div></div>
  <h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p>
  <div class="ia"><a class="btn" href="{{ routes.root_url }}">{{ 'notfound.home' | t }}</a>{%- if section.settings.collection -%}<a class="btn ol" href="{{ section.settings.collection.url }}">{{ 'notfound.shop' | t }}</a>{%- endif -%}</div>
</div></div></section>
{%- assign col = section.settings.collection -%}
{%- if col.products.size > 0 -%}
<section class="sec sx-sec"><div class="wrap">{% render 'sec-head', heading: section.settings.products_heading, link_label: 'Shop all', link: col.url %}<div class="grid">{%- for p in col.products limit: 4 -%}{% render 'product-card', product: p %}{%- endfor -%}</div></div></section>
{%- endif -%}
</div>
{% schema %}
{
  "name": "Page not found",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Game, set and missing page." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We cannot find that page. It may have moved, or the link may be wrong." },
    { "type": "collection", "id": "collection", "label": "Products from" },
    { "type": "text", "id": "products_heading", "label": "Products heading", "default": "Popular right now" }
  ]
}
{% endschema %}
