{%- assign s = section.settings -%}
<section class="zm" id="zm"><div class="st" id="zst">
  {%- if s.video != blank -%}{{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1600x' }}
  {%- elsif s.image != blank -%}{{ s.image | image_url: width: 2000 | image_tag: alt: '' }}{%- endif -%}
  <div class="mask" id="zmk"><span id="zw">{{ s.wordmark | upcase }}</span></div><div class="shade" id="zsh"></div>
  <div class="end" id="zen"><div class="wrap"><h1>{{ s.heading }}</h1>{%- if settings.tp_label != blank -%}<div class="sstar"><span class="rst s5"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i></span><span><b>{{ settings.tp_label }}</b> on Trustpilot</span></div>{%- endif -%}</div></div>
</div></section>
{% schema %}
{
  "name": "About hero",
  "settings": [
    { "type": "video", "id": "video", "label": "Brand film" },
    { "type": "image_picker", "id": "image", "label": "Or image" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Raqello" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Europe's best padel brands, in one UK store" }
  ],
  "presets": [ { "name": "About hero" } ]
}
{% endschema %}
