<footer class="ftr3">
  {%- if section.settings.show_newsletter -%}
  <div class="fnl"><div class="wrap">
    <div><h3>{{ section.settings.nl_heading }}</h3><p>{{ section.settings.nl_text }}</p></div>
    {%- form 'customer', id: 'footer-newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="nlok" role="status">{{ 'newsletter.thanks' | t }}</p>
      {%- else -%}
        <input id="fnl" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required aria-label="{{ 'newsletter.email' | t }}" autocomplete="email">
        <button type="submit">{{ 'newsletter.button' | t }}</button>
      {%- endif -%}
      {%- if form.errors -%}<p class="nlerr">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div></div>
  {%- endif -%}
  <div class="wrap fmain">
    <div class="fbrand">
      <a class="logo" href="{{ routes.root_url }}">{{ section.settings.wordmark | default: shop.name | upcase }}<i>.</i></a>
      <p>{{ section.settings.tagline }}</p>
      {%- if settings.tp_label != blank -%}<div class="ftpm"><b>{{ settings.tp_label }}</b>{% render 'stars', size: 's' %}<span>{{ settings.tp_score }} out of 5</span>{% render 'icon', name: 'tp' %}</div>{%- endif -%}
      <div class="fsoc">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">YouTube</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" rel="noopener" target="_blank">Facebook</a>{%- endif -%}
      </div>
    </div>
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}><h4 role="button" tabindex="0">{{ block.settings.heading | default: linklists[block.settings.menu].title }}</h4><ul>
        {%- for link in linklists[block.settings.menu].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
      </ul></div>
    {%- endfor -%}
  </div>
  <div class="wrap fbot">
    <div class="fpay">
      {%- for type in shop.enabled_payment_types -%}<i title="{{ type | replace: '_', ' ' | capitalize }}">{{ type | payment_type_svg_tag }}</i>{%- endfor -%}
    </div>
    <div class="flegal"><span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- for link in linklists[section.settings.legal_menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "Show the sign up bar", "default": true },
    { "type": "text", "id": "nl_heading", "label": "Sign up heading", "default": "Get new drops first" },
    { "type": "text", "id": "nl_text", "label": "Sign up text", "default": "New rackets, restocks and sale previews." },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Raqello" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Europe's best padel brands, in one UK store." },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "default": "footer" }
  ],
  "blocks": [
    { "type": "menu", "name": "Link column", "limit": 5, "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "link_list", "id": "menu", "label": "Menu" }
    ] }
  ]
}
{% endschema %}
