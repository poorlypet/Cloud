{%- assign s = section.settings -%}
<div class="uc">
  <div class="bg">
    {%- if s.video != blank -%}{{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1600x' }}
    {%- elsif s.image != blank -%}{{ s.image | image_url: width: 2400 | image_tag: widths: '750, 1200, 1800, 2400', sizes: '100vw', alt: '' }}
    {%- else -%}<span class="note">{{ s.note }}</span>{%- endif -%}
  </div>
  <header class="top"><span class="logo">{{ s.wordmark | upcase }}<i>.</i></span><span class="chip">{{ s.chip }}</span></header>
  <main class="mid">
    <div class="wm" aria-hidden="true">{{ s.wordmark | upcase }}<i>.</i></div>
    <div class="row">
      <div><small class="lab">{{ s.label }}</small><h1>{{ s.heading }}</h1><p>{{ shop.password_message | default: s.text }}</p></div>
      <div>
        {%- form 'customer', class: 'nl' -%}
          {%- if form.posted_successfully? -%}
            <p class="ok" role="status">{{ s.thanks }}</p>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="prelaunch, newsletter">
            <input type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required aria-label="{{ 'newsletter.email' | t }}" autocomplete="email">
            <button type="submit">{{ s.button }}</button>
          {%- endif -%}
          {%- if form.errors -%}<p class="err">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
        <p class="fine">{{ s.fine }}</p>
      </div>
    </div>
  </main>
  {%- assign brands = s.brands | split: ',' -%}
  {%- if brands.size > 0 -%}
  <div class="brands" aria-label="{{ s.brands_label }}"><div class="rl">{%- for i in (1..2) -%}{%- for b in brands -%}<span{% if i == 2 %} aria-hidden="true"{% endif %}>{{ b | strip }}</span>{%- endfor -%}{%- endfor -%}</div></div>
  {%- endif -%}
  <footer class="bot">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ s.footer }}</span>
    <nav>
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
      {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
      <button class="own" type="button" onclick="document.getElementById('pwd').showModal()">{{ 'password.owner' | t }}</button>
    </nav>
  </footer>
</div>
<dialog class="pwd" id="pwd"><div class="bx">
  <h2>{{ 'password.enter' | t }}</h2><p>{{ 'password.enter_text' | t }}</p>
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<p class="err" style="color:#c62828">{{ form.errors | default_errors }}</p>{%- endif -%}
    <input type="password" name="password" placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}" autocomplete="current-password" required>
    <div class="act"><button type="submit">{{ 'password.enter_button' | t }}</button><button class="ol" type="button" onclick="this.closest('dialog').close()">{{ 'general.close' | t }}</button></div>
  {%- endform -%}
  <p style="margin:14px 0 0">{{ 'password.admin_html' | t: url: '/admin' }}</p>
</div></dialog>
<script>if(document.querySelector('#pwd .err'))document.getElementById('pwd').showModal();</script>
{% schema %}
{
  "name": "Under construction",
  "settings": [
    { "type": "video", "id": "video", "label": "Background video" },
    { "type": "image_picker", "id": "image", "label": "Or background image" },
    { "type": "text", "id": "note", "label": "Placeholder note", "default": "Video: rally on an outdoor court at dusk" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Raqello" },
    { "type": "text", "id": "chip", "label": "Status", "default": "Under construction" },
    { "type": "text", "id": "label", "label": "Small label", "default": "Opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Europe's best padel brands, in one UK store." },
    { "type": "textarea", "id": "text", "label": "Text", "info": "The message you set under Preferences, Password protection, is used first.", "default": "We are building the store now. Leave your email and we will tell you the day we open." },
    { "type": "text", "id": "button", "label": "Button", "default": "Tell me first" },
    { "type": "text", "id": "thanks", "label": "Thank you message", "default": "You are on the list. We will email you the day we open." },
    { "type": "text", "id": "fine", "label": "Small print", "default": "One email when we open. No spam." },
    { "type": "text", "id": "brands_label", "label": "Brands label", "default": "Brands we will stock" },
    { "type": "textarea", "id": "brands", "label": "Brands", "default": "Bullpadel, Nox, Head, Babolat, Adidas Padel, StarVie, Siux, Wilson, Dunlop, Drop Shot, Black Crown, Varlion" },
    { "type": "text", "id": "footer", "label": "Footer text", "default": "Padel rackets, shoes and kit." }
  ]
}
{% endschema %}
