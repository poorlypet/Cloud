{%- assign s = section.settings -%}
{%- assign src = s.collection -%}
<div class="pg sx bgx">
<div class="wrap">{% render 'crumbs', title: page.title, parent_title: s.parent_label, parent_url: s.parent_link %}</div>
<section class="sec sx-sec pt0"><div class="wrap">
  <div class="bgx-h"><small>{{ s.label }}</small><h1>{{ s.heading }}</h1>{%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}</div>
  <div class="bgx-g">
    {%- assign vendors = src.all_vendors | sort_natural -%}
    {%- for v in vendors -%}
      {%- assign h = v | handleize | append: s.suffix -%}{%- assign bc = collections[h] -%}
      {%- assign n = bc.products_count | plus: 0 -%}
      {%- if n > 0 -%}
        {%- assign logo = bc.metafields.custom.logo.value -%}
        <a class="bgx-t" href="{{ bc.url }}">
          <span class="bgx-p">{%- if bc.image -%}{{ bc.image | image_url: width: 600 | image_tag: class: 'fill', loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 17vw, 50vw', alt: '' }}{%- endif -%}{%- if logo -%}<i class="bgx-l">{{ logo | image_url: height: 80 | image_tag: alt: v, loading: 'lazy' }}</i>{%- endif -%}</span>
          <span class="bgx-n"><b>{{ v }}</b><small>{{ n }} {% if n == 1 %}{{ s.unit_one }}{% else %}{{ s.unit }}{% endif %}</small></span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div></section>
</div>
{% schema %}
{
  "name": "Brand grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Show brands from this collection" },
    { "type": "text", "id": "suffix", "label": "Brand collection ending", "default": "-padel-rackets", "info": "Each brand links to the collection with its name plus this ending, for example bullpadel-padel-rackets." },
    { "type": "text", "id": "label", "label": "Small label", "default": "Padel rackets" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop rackets by brand" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "unit", "label": "Count word", "default": "rackets" },
    { "type": "text", "id": "unit_one", "label": "Count word for one", "default": "racket" },
    { "type": "text", "id": "parent_label", "label": "Breadcrumb parent", "default": "Padel rackets" },
    { "type": "url", "id": "parent_link", "label": "Breadcrumb parent link" }
  ]
}
{% endschema %}
