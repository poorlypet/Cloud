{%- assign s = section.settings -%}
<section class="sec sx-sec"><div class="wrap"><div class="sxhelp">
  <div class="pph hp">{% render 'ph', image: s.image, note: s.note, cls: 'fill', sizes: '40vw' %}</div>
  <div><h2>{{ s.heading }}</h2><p>{{ s.text }}</p><div class="ia"><a class="btn" href="{{ s.button_link }}">{{ s.button_label }}</a>{%- if s.link_label != blank -%}<a class="ul" href="{{ s.link }}">{{ s.link_label }}</a>{%- endif -%}</div></div>
</div></div></section>
{% schema %}
{
  "name": "Help banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "note", "label": "Placeholder note", "default": "our customer team at their desks" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still need a hand?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Our team are players too. We are here Monday to Friday, 9am to 5pm and usually reply within one working day." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Second link", "default": "Visit the help centre" },
    { "type": "url", "id": "link", "label": "Second link URL" }
  ],
  "presets": [ { "name": "Help banner" } ]
}
{% endschema %}
