{%- assign rows = rs | newline_to_br | split: '<br />' -%}
{%- for row in rows limit: limit -%}{%- assign c = row | strip | split: '|' -%}
<article class="tpc"><div class="tpt">{% render 'stars', size: 's' %}<span class="ver">{% render 'icon', name: 'verified' %}Verified</span></div><h4>{{ c[0] }}</h4><p>{{ c[1] }}</p><div class="tpw2"><b>{{ c[2] }}</b><span>{{ c[3] }}</span></div>{%- if product != blank -%}<div class="tpb"><i>{%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: alt: '' }}{%- endif -%}</i><span>Bought <b>{{ product.title }}</b></span></div>{%- endif -%}</article>
{%- endfor -%}
{%- endif -%}
