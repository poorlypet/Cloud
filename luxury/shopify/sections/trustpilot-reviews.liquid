{%- comment -%}
  Axel & Hound · Reviews page, using Trustpilot's official TrustBox widget.
  Get the two IDs from Trustpilot Business: Integrations > TrustBox library.
  Pick the widget you want (for a full reviews page, a list or grid TrustBox),
  copy its template ID and your business unit ID into the theme editor.
{%- endcomment -%}
<div class="ss tight">
  <header class="ss-head">
    <span class="ss-kick">Reviews</span>
    <h1 class="ss-h1">{{ section.settings.heading }}</h1>
    <p class="ss-lead">{{ section.settings.intro }}</p>
  </header>
  <section class="ss-in">
    <div class="trustpilot-widget" data-locale="en-GB"
         data-template-id="{{ section.settings.template_id }}"
         data-businessunit-id="{{ section.settings.business_unit_id }}"
         data-style-height="{{ section.settings.height }}px" data-style-width="100%" data-theme="light">
      <a href="{{ section.settings.profile_url }}" target="_blank" rel="noopener">Trustpilot</a>
    </div>
  </section>
</div>
<script src="https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
{% schema %}
{
  "name": "Trustpilot reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Every review is collected and verified by Trustpilot." },
    { "type": "text", "id": "template_id", "label": "TrustBox template ID" },
    { "type": "text", "id": "business_unit_id", "label": "Trustpilot business unit ID" },
    { "type": "url", "id": "profile_url", "label": "Your Trustpilot page" },
    { "type": "range", "id": "height", "label": "Widget height", "min": 400, "max": 1400, "step": 50, "default": 800, "unit": "px" }
  ]
}
{% endschema %}
