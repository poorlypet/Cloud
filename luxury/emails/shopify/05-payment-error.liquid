="right" style="font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12.5px;color:#8A8A85;">{{ order_name }}</td></tr></table><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% for line in subtotal_line_items %}<tr><td width="96" valign="top" style="padding:16px 18px 16px 0;border-bottom:1px solid #E6E4DE;">{% if line.image %}<img src="{{ line | img_url: '240x240', crop: 'center' }}" width="96" height="96" alt="" style="width:96px;height:96px;background:#F1F0EC;">{% else %}<div style="width:96px;height:96px;background:#F1F0EC;"></div>{% endif %}</td><td valign="top" style="padding:16px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14.5px;line-height:1.45;color:#111111;border-bottom:1px solid #E6E4DE;">{{ line.product.title | default: line.title }}{% if line.variant.title != blank and line.variant.title != "Default Title" %}<div style="font-size:12.5px;color:#8A8A85;margin-top:4px;">{{ line.variant.title }}</div>{% endif %}<div style="font-size:12.5px;color:#8A8A85;margin-top:4px;">Quantity {{ line.quantity }}</div></td><td valign="top" align="right" style="padding:16px 0 16px 12px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#111111;white-space:nowrap;border-bottom:1px solid #E6E4DE;">{% if line.original_line_price != line.final_line_price %}<s style="color:#8A8A85;">{{ line.original_line_price | money }}</s><br>{% endif %}{{ line.final_line_price | money }}</td></tr>{% endfor %}<tr><td colspan="3" style="padding:0 0 10px;"></td></tr></table></td></tr></table></td></tr>
<tr><td style="padding:44px 0 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F7F5F0;border-top:1px solid #E6E4DE;border-bottom:1px solid #E6E4DE;"><tr>
