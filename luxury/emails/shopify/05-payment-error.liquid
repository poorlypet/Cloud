<a href="{{ shop.url }}/collections/new-in" style="color:#111111;text-decoration:none;">New in</a><span style="color:#8A8A85;">&nbsp;&nbsp;&nbsp;&nbsp;</span><a href="{{ shop.url }}/collections/beds" style="color:#111111;text-decoration:none;">Beds</a><span style="color:#8A8A85;">&nbsp;&nbsp;&nbsp;&nbsp;</span><a href="{{ shop.url }}/collections/walking" style="color:#111111;text-decoration:none;">Walking</a><span style="color:#8A8A85;">&nbsp;&nbsp;&nbsp;&nbsp;</span><a href="{{ shop.url }}/collections/coats" style="color:#111111;text-decoration:none;">Coats</a><span style="color:#8A8A85;">&nbsp;&nbsp;&nbsp;&nbsp;</span><a href="{{ shop.url }}/collections/sale" style="color:#111111;text-decoration:none;">Sale</a></td></tr>
