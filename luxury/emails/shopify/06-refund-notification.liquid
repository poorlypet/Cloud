<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="x-apple-disable-message-reformatting">
<title>{{ email_title }}</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500;600&display=swap" rel="stylesheet">
<style>body{margin:0;padding:0;background:#ffffff}a{color:#111111}img{border:0;display:block}@media (max-width:620px){.w{width:100%!important}.px{padding-left:22px!important;padding-right:22px!important}.h1{font-size:32px!important}.col{display:block!important;width:100%!important}}</style></head>
<body style="margin:0;padding:0;background:#ffffff;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">Your refund is on its way.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;"><tr><td align="center" style="padding:24px 0 40px;">
<table role="presentation" class="w" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;">
<tr><td class="px" align="center" style="padding:28px 40px 24px;border-bottom:1px solid #E6E4DE;">
<a href="{{ shop.url }}" style="text-decoration:none;color:#111111;">{% if shop.email_logo_url != blank %}<img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 220 }}" style="max-width:220px;height:auto;margin:0 auto;">{% else %}<span style="font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:30px;line-height:1;font-weight:600;color:#111111;">Axel <i style="font-weight:500;">&amp;</i> Hound</span>{% endif %}</a>
</td></tr>
<tr><td class="px" align="center" style="padding:44px 40px 6px;"><p style="margin:0 0 14px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2.4px;text-transform:uppercase;color:#4F4F4B;">Order {{ order_name }}</p><h1 class="h1" style="margin:0;font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-weight:500;font-size:40px;line-height:1.1;color:#111111;">Your refund is on its way</h1><p style="margin:16px auto 0;max-width:450px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.7;color:#4F4F4B;">{% assign refund_total = 0 %}{% for t in transactions %}{% if t.kind == "refund" and t.status == "success" %}{% assign refund_total = refund_total | plus: t.amount %}{% endif %}{% endfor %}{% if refund_total > 0 %}We have refunded {{ refund_total | money }} to your original payment method. {% else %}We have processed your refund to your original payment method. {% endif %}It can take 5 to 10 working days to show on your statement.</p></td></tr><tr><td align="center" style="padding:28px 40px 6px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="background:#ffffff;border:1px solid #111111;"><a href="{{ order_status_url }}" style="display:inline-block;padding:16px 36px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11.5px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;color:#111111;text-decoration:none;">View your order</a></td></tr></table></td></tr>{% if refund_line_items.size > 0 %}<tr><td class="px" style="padding:36px 40px 0;"><p style="margin:0 0 12px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#111111;">Refunded items</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% for line in refund_line_items %}<tr><td width="76" valign="top" style="padding:0 16px 18px 0;">{% if line.line_item.image %}<img src="{{ line.line_item | img_url: 'compact_cropped' }}" width="76" height="76" alt="" style="width:76px;height:76px;object-fit:cover;background:#F1F0EC;">{% endif %}</td><td valign="top" style="padding:0 0 18px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#111111;">{{ line.line_item.product.title | default: line.line_item.title }}{% if line.line_item.variant.title != "Default Title" %}<div style="font-size:12.5px;color:#8A8A85;margin-top:2px;">{{ line.line_item.variant.title }}</div>{% endif %}<div style="font-size:12.5px;color:#8A8A85;margin-top:2px;">Qty {{ line.quantity }}</div></td><td valign="top" align="right" style="padding:0 0 18px 12px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#111111;white-space:nowrap;">{{ line.subtotal | money }}</td></tr>{% endfor %}</table></td></tr>{% endif %}
<tr><td class="px" align="center" style="padding:40px 40px 0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #E6E4DE;"><tr><td align="center" style="padding-top:30px;">
<p style="margin:0 0 14px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;"><a href="{{ shop.url }}/collections/new-in" style="color:#111111;text-decoration:none;">Shop</a>&nbsp;&nbsp;&middot;&nbsp;&nbsp;<a href="{{ shop.url }}/pages/delivery" style="color:#111111;text-decoration:none;">Delivery</a>&nbsp;&nbsp;&middot;&nbsp;&nbsp;<a href="{{ shop.url }}/pages/returns" style="color:#111111;text-decoration:none;">Returns</a>&nbsp;&nbsp;&middot;&nbsp;&nbsp;<a href="{{ shop.url }}/pages/help" style="color:#111111;text-decoration:none;">Help</a></p>
<p style="margin:0 0 6px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:1.7;color:#4F4F4B;">Questions? Reply to this email and a real person will get back to you within one working day.</p>
<p style="margin:0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11.5px;line-height:1.7;color:#8A8A85;">{{ shop.name }} &middot; <a href="mailto:{{ shop.email }}" style="color:#8A8A85;">{{ shop.email }}</a></p>
</td></tr></table>
</td></tr>
</table></td></tr></table></body></html>