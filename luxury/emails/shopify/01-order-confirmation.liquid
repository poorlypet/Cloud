ont-size:10.5px;letter-spacing:1.4px;text-transform:uppercase;font-weight:600;color:#111111;">Ordered</div></td><td width="25%" valign="top" style="padding:0 3px;"><div style="height:4px;background:#E6E4DE;font-size:0;line-height:0;">&nbsp;</div><div class="step" style="padding-top:10px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:10.5px;letter-spacing:1.4px;text-transform:uppercase;font-weight:400;color:#8A8A85;">Dispatched</div></td><td width="25%" valign="top" style="padding:0 3px;"><div style="height:4px;background:#E6E4DE;font-size:0;line-height:0;">&nbsp;</div><div class="step" style="padding-top:10px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:10.5px;letter-spacing:1.4px;text-transform:uppercase;font-weight:400;color:#8A8A85;">Out for delivery</div></td><td width="25%" valign="top" style="padding:0 3px;"><div style="height:4px;background:#E6E4DE;font-size:0;line-height:0;">&nbsp;</div><div class="step" style="padding-top:10px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:10.5px;letter-spacing:1.4px;text-transform:uppercase;font-weight:400;color:#8A8A85;">Delivered</div></td></tr></table></td></tr><tr><td class="px" style="padding:40px 32px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F7F5F0;"><tr><td style="padding:26px 26px 10px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2.2px;text-transform:uppercase;color:#111111;">Your order</td><td align="right" style="font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12.5px;color:#8A8A85;">{{ order_name }}</td></tr></table><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% for line in subtotal_line_items %}<tr><td width="96" valign="top" style="padding:16px 18px 16px 0;border-bottom:1px solid #E6E4DE;">{% if line.image %}<img src="{{ line | img_url: '240x240', crop: 'center' }}" width="96" height="96" alt="" style="width:96px;height:96px;background:#F1F0EC;">{% else %}<div style="width:96px;height:96px;background:#F1F0EC;"></div>{% endif %}</td><td valign="top" style="padding:16px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14.5px;line-height:1.45;color:#111111;border-bottom:1px solid #E6E4DE;">{{ line.product.title | default: line.title }}{% if line.variant.title != blank and line.variant.title != "Default Title" %}<div style="font-size:12.5px;color:#8A8A85;margin-top:4px;">{{ line.variant.title }}</div>{% endif %}<div style="font-size:12.5px;color:#8A8A85;margin-top:4px;">Quantity {{ line.quantity }}</div></td><td valign="top" align="right" style="padding:16px 0 16px 12px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#111111;white-space:nowrap;border-bottom:1px solid #E6E4DE;">{% if line.original_line_price != line.final_line_price %}<s style="color:#8A8A85;">{{ line.original_line_price | money }}</s><br>{% endif %}{{ line.final_line_price | money }}</td></tr>{% endfor %}<tr><td colspan="3" style="padding:16px 0 18px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding:5px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#4A4A46;">Subtotal</td><td align="right" style="padding:5px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#111111;">{{ subtotal_price | money }}</td></tr>{% for discount_application in cart_level_discount_applications %}<tr><td style="padding:5px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#4A4A46;">Discount{% if discount_application.title != blank %} &middot; {{ discount_application.title }}{% endif %}</td><td align="right" style="padding:5px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#111111;">&minus;{{ discount_application.total_allocated_amount | money }}</td></tr>{% endfor %}{% if requires_shipping %}<tr><td style="padding:5px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#4A4A46;">Delivery</td><td align="right" style="padding:5px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#111111;">{% if shipping_price == 0 %}Free{% else %}{{ shipping_price | money }}{% endif %}</td></tr>{% endif %}{% if total_duties > 0 %}<tr><td style="padding:5px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#4A4A46;">Duties</td><td align="right" style="padding:5px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#111111;">{{ total_duties | money }}</td></tr>{% endif %}<tr><td style="padding:14px 0 4px;font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:24px;font-weight:500;color:#111111;">Total</td><td align="right" style="padding:14px 0 4px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:17px;font-weight:600;color:#111111;">{{ total_price | money_with_currency }}</td></tr>{% if tax_price > 0 %}<tr><td colspan="2" align="right" style="padding:0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#8A8A85;">{% if taxes_included %}Including{% else %}Plus{% endif %} {{ tax_price | money }} tax</td></tr>{% endif %}</table></td></tr></table></td></tr></table></td></tr>{% if shipping_address %}<tr><td class="px" style="padding:34px 48px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="col" width="50%" valign="top" style="padding-right:16px;"><p style="margin:0 0 16px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2.2px;text-transform:uppercase;color:#111111;">Delivering to</p><p style="margin:0