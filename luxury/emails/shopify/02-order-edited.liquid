<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="x-apple-disable-message-reformatting">
<title>{{ email_title }}</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500;600&display=swap" rel="stylesheet">
<style>body{margin:0;padding:0;background:#ffffff}a{color:#111111}img{border:0;display:block}@media (max-width:620px){.w{width:100%!important}.px{padding-left:22px!important;padding-right:22px!important}.h1{font-size:32px!important}.col{display:block!important;width:100%!important}}</style></head>
<body style="margin:0;padding:0;background:#ffffff;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">Here is your updated order.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;"><tr><td align="center" style="padding:24px 0 40px;">
<table role="presentation" class="w" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;">
<tr><td class="px" align="center" style="padding:28px 40px 24px;border-bottom:1px solid #E6E4DE;">
<a href="{{ shop.url }}" style="text-decoration:none;color:#111111;">{% if shop.email_logo_url != blank %}<img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 220 }}" style="max-width:220px;height:auto;margin:0 auto;">{% else %}<span style="font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:30px;line-height:1;font-weight:600;color:#111111;">Axel <i style="font-weight:500;">&amp;</i> Hound</span>{% endif %}</a>
</td></tr>
<tr><td class="px" align="center" style="padding:44px 40px 6px;"><p style="margin:0 0 14px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2.4px;text-transform:uppercase;color:#4F4F4B;">Order {{ order_name }}</p><h1 class="h1" style="margin:0;font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-weight:500;font-size:40px;line-height:1.1;color:#111111;">Your order has been updated</h1><p style="margin:16px auto 0;max-width:450px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.7;color:#4F4F4B;">We have made the changes to your order. Here is how it looks now.</p></td></tr><tr><td align="center" style="padding:28px 40px 6px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="background:#111111;border:1px solid #111111;"><a href="{{ order_status_url }}" style="display:inline-block;padding:16px 36px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11.5px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;color:#ffffff;text-decoration:none;">View your order</a></td></tr></table></td></tr><tr><td class="px" style="padding:36px 40px 0;"><p style="margin:0 0 12px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#111111;">Your order</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% for line in subtotal_line_items %}<tr><td width="76" valign="top" style="padding:0 16px 18px 0;">{% if line.image %}<img src="{{ line | img_url: 'compact_cropped' }}" width="76" height="76" alt="" style="width:76px;height:76px;object-fit:cover;background:#F1F0EC;">{% endif %}</td><td valign="top" style="padding:0 0 18px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#111111;">{{ line.product.title | default: line.title }}{% if line.variant.title != "Default Title" %}<div style="font-size:12.5px;color:#8A8A85;margin-top:2px;">{{ line.variant.title }}</div>{% endif %}<div style="font-size:12.5px;color:#8A8A85;margin-top:2px;">Qty {{ line.quantity }}</div></td><td valign="top" align="right" style="padding:0 0 18px 12px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#111111;white-space:nowrap;">{% if line.original_line_price != line.final_line_price %}<s style="color:#8A8A85;">{{ line.original_line_price | money }}</s><br>{% endif %}{{ line.final_line_price | money }}</td></tr>{% endfor %}</table></td></tr><tr><td class="px" style="padding:8px 40px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #E6E4DE;"><tr><td style="padding-top:12px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding:6px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:400;color:#111111;">Subtotal</td><td align="right" style="padding:6px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:400;color:#111111;">{{ subtotal_price | money }}</td></tr>{% for discount_application in cart_level_discount_applications %}<tr><td style="padding:6px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:400;color:#111111;">Discount{% if discount_application.title %} ({{ discount_application.title }}){% endif %}</td><td align="right" style="padding:6px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:400;color:#111111;">&minus;{{ discount_application.total_allocated_amount | money }}</td></tr>{% endfor %}{% if requires_shipping %}<tr><td style="padding:6px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:400;color:#111111;">Delivery</td><td align="right" style="padding:6px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:400;color:#111111;">{% if shipping_price == 0 %}Free{% else %}{{ shipping_price | money }}{% endif %}</td></tr>{% endif %}{% if total_duties > 0 %}<tr><td style="padding:6px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:400;color:#111111;">Duties</td><td align="right" style="padding:6px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:400;color:#111111;">{{ total_duties | money }}</td></tr>{% endif %}<tr><td style="padding:6px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;color:#111111;">Total</td><td align="right" style="padding:6px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;color:#111111;">{{ total_price | money_with_currency }}</td></tr>{% if tax_price > 0 %}<tr><td colspan="2" align="right" style="padding:0 0 4px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#8A8A85;">{% if taxes_included %}Includes{% else %}Plus{% endif %} {{ tax_price | money }} tax</td></tr>{% endif %}</table></td></tr></table></td></tr>{% if shipping_address %}<tr><td class="px" style="padding:30px 40px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="col" width="50%" valign="top" style="padding-right:12px;"><p style="margin:0 0 12px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#111111;">Delivering to</p><p style="margin:0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#4F4F4B;">{{ shipping_address.name }}<br>{{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}<br>{{ shipping_address.address2 }}{% endif %}<br>{{ shipping_address.city }} {{ shipping_address.zip }}<br>{{ shipping_address.country }}</p></td><td class="col" width="50%" valign="top"><p style="margin:0 0 12px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#111111;">Delivery</p><p style="margin:0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#4F4F4B;">{% if shipping_method %}{{ shipping_method.title }}<br>{% endif %}Dispatched the next working day, tracked to your door.</p></td></tr></table></td></tr>{% endif %}
<tr><td class="px" align="center" style="padding:40px 40px 0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #E6E4DE;"><tr><td align="center" style="padding-top:30px;">
<p style="margin:0 0 14px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;"><a href="{{ shop.url }}/collections/new-in" style="color:#111111;text-decoration:none;">Shop</a>&nbsp;&nbsp;&middot;&nbsp;&nbsp;<a href="{{ shop.url }}/pages/delivery" style="color:#111111;text-decoration:none;">Delivery</a>&nbsp;&nbsp;&middot;&nbsp;&nbsp;<a href="{{ shop.url }}/pages/returns" style="color:#111111;text-decoration:none;">Returns</a>&nbsp;&nbsp;&middot;&nbsp;&nbsp;<a href="{{ shop.url }}/pages/help" style="color:#111111;text-decoration:none;">Help</a></p>
<p style="margin:0 0 6px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:1.7;color:#4F4F4B;">Questions? Reply to this email and a real person will get back to you within one working day.</p>
<p style="margin:0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11.5px;line-height:1.7;color:#8A8A85;">{{ shop.name }} &middot; <a href="mailto:{{ shop.email }}" style="color:#8A8A85;">{{ shop.email }}</a></p>
</td></tr></table>
</td></tr>
</table></td></tr></table></body></html>