{%- comment -%}
  Black Friday Week pop-up, behind an email step: the shopper enters their email to see the 15% code.
  Emails are saved to Shopify customers (subscribed to email marketing, tagged "newsletter" and "black-friday-2026").
  Five green designs. bf_live = 0 keeps it off for shoppers; set it to 1-5 to put that design live.
  Preview any design without going live by adding ?bf=1 (to 5) to a page address.
  Class names all start "bfp" so they never collide with the site footer (.bf).
{%- endcomment -%}
{%- assign bf_live = 2 -%}
{%- assign bf_code = 'BLACKFRIDAY15' -%}
{%- assign st = shop.metafields.custom.ah_media.value.stills -%}
{%- capture bf_go -%}/discount/{{ bf_code }}?redirect={{ routes.root_url | append: '/collections/new-in' | replace: '//', '/' | url_encode }}{%- endcapture -%}
{%- capture bf_k -%}<p class="bfp-k">Black Friday Week</p>{%- endcapture -%}
<div class="bfp" id="bfp" data-live="{{ bf_live }}" data-code="{{ bf_code }}" hidden>
  <div class="bfp-scrim" data-bfp-x></div>

  {%- comment -%} 1 · Big number, centred {%- endcomment -%}
  <div class="bfp-v bfp1" data-v="1" role="dialog" aria-modal="true" aria-label="Black Friday Week offer" hidden>
    <button type="button" class="bfp-x" data-bfp-x aria-label="Close">&times;</button>
    {{ bf_k }}
    <p class="bfp-n">15<i>%</i></p>
    <h2 class="bfp-h it">off everything</h2>
    <div class="bfp-slot"></div>
  </div>

  {%- comment -%} 2 · Photograph left, offer right {%- endcomment -%}
  <div class="bfp-v bfp2" data-v="2" role="dialog" aria-modal="true" aria-label="Black Friday Week offer" hidden>
    <button type="button" class="bfp-x" data-bfp-x aria-label="Close">&times;</button>
    <div class="bfp2-ph">{%- if st['menu-new-knitwear'] != blank -%}<img src="{{ st['menu-new-knitwear'] }}&width=900&height=1100&crop=center" alt="" loading="lazy">{%- endif -%}</div>
    <div class="bfp2-tx">
      {{ bf_k }}
      <h2 class="bfp-h">15% off<br>everything</h2>
      <div class="bfp-slot"></div>
    </div>
  </div>

  {%- comment -%} 3 · Photograph on top {%- endcomment -%}
  <div class="bfp-v bfp3" data-v="3" role="dialog" aria-modal="true" aria-label="Black Friday Week offer" hidden>
    <button type="button" class="bfp-x on-ph" data-bfp-x aria-label="Close">&times;</button>
    {%- if st['home-dachshund'] != blank -%}<img class="bfp3-ph" src="{{ st['home-dachshund'] }}&width=960&height=530&crop=center" alt="" loading="lazy">{%- endif -%}
    <div class="bfp3-tx">
      {{ bf_k }}
      <h2 class="bfp-h">15% off everything</h2>
      <div class="bfp-slot"></div>
    </div>
  </div>

  {%- comment -%} 4 · Framed, with the ampersand {%- endcomment -%}
  <div class="bfp-v bfp4" data-v="4" role="dialog" aria-modal="true" aria-label="Black Friday Week offer" hidden>
    <button type="button" class="bfp-x" data-bfp-x aria-label="Close">&times;</button>
    <div class="bfp4-in">
      <p class="bfp4-amp" aria-hidden="true">&amp;</p>
      {{ bf_k }}
      <h2 class="bfp-h">15% off <i>everything</i></h2>
      <div class="bfp-rule"></div>
      <div class="bfp-slot"></div>
    </div>
  </div>

  {%- comment -%} 5 · Corner card: slides in bottom right, page stays usable {%- endcomment -%}
  <div class="bfp-v bfp5" data-v="5" data-noscrim role="dialog" aria-label="Black Friday Week offer" hidden>
    <button type="button" class="bfp-x on-ph" data-bfp-x aria-label="Close">&times;</button>
    {%- if st['home-category-coats'] != blank -%}<img class="bfp5-ph" src="{{ st['home-category-coats'] }}&width=760&height=360&crop=center" alt="" loading="lazy">{%- endif -%}
    <div class="bfp5-tx">
      {{ bf_k }}
      <h2 class="bfp-h">15% off everything</h2>
      <div class="bfp-slot"></div>
    </div>
  </div>

  {%- comment -%} Shared by every design: the email step, then the code {%- endcomment -%}
  <div class="bfp-parts" hidden>
    <div class="bfp-gate" data-bfp-gate>
      <p class="bfp-p">Enter your email and we&rsquo;ll show you the code. This week only, across the whole shop.</p>
      {%- form 'customer', id: 'bfp-form', class: 'bfp-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, black-friday-2026">
        <label class="bfp-vh" for="bfp-email">Email address</label>
        <input id="bfp-email" class="bfp-in" type="email" name="contact[email]" placeholder="Your email address" autocomplete="email" required>
        <button type="submit" class="bfp-btn">Show my 15% code</button>
        <p class="bfp-err" role="alert" hidden></p>
      {%- endform -%}
      <p class="bfp-s">By entering your email you agree to receive emails from Axel &amp; Hound. Unsubscribe at any time. <a href="/pages/privacy-policy">Privacy policy</a></p>
    </div>
    <div class="bfp-rev" data-bfp-rev hidden>
      <p class="bfp-p">Thank you. Here&rsquo;s your code for 15% off everything this week.</p>
      <div class="bfp-code"><b>{{ bf_code }}</b><button type="button" data-bfp-copy>Copy</button></div>
      <a class="bfp-btn" href="{{ bf_go }}">Shop now</a>
      <p class="bfp-s">Applied at checkout. One use per customer. Can&rsquo;t be combined with other codes.</p>
    </div>
  </div>
</div>
<style>
.bfp{position:fixed;inset:0;z-index:8900;pointer-events:none;font-family:var(--sans,"Jost",system-ui,sans-serif);color:#F4F1EA}
.bfp[hidden],.bfp-v[hidden],.bfp-parts[hidden],.bfp [hidden]{display:none}
.bfp-scrim{position:absolute;inset:0;background:rgba(17,17,17,.55);pointer-events:auto;animation:bfp-f .3s ease both}
.bfp.noscrim .bfp-scrim{display:none}
@keyframes bfp-f{from{opacity:0}to{opacity:1}}
@keyframes bfp-up{from{opacity:0;transform:translate(-50%,calc(-50% + 16px))}to{opacity:1;transform:translate(-50%,-50%)}}
@keyframes bfp-in{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.bfp-v{pointer-events:auto;position:absolute;background:#2E3422;color:#F4F1EA;box-shadow:0 24px 70px rgba(17,17,17,.35);text-align:center}
.bfp1,.bfp2,.bfp3,.bfp4{left:50%;top:50%;transform:translate(-50%,-50%);animation:bfp-up .4s ease both;max-height:calc(100vh - 32px);overflow:auto}
.bfp-x{position:absolute;top:8px;right:10px;width:40px;height:40px;border:0;background:none;font:300 30px/1 var(--sans,system-ui);color:#F4F1EA;cursor:pointer;z-index:2}
.bfp-x.on-ph{text-shadow:0 1px 8px rgba(0,0,0,.55)}
.bfp-k{margin:0 0 14px;font-size:11px;font-weight:500;letter-spacing:.26em;text-transform:uppercase;color:#C9CBBE}
.bfp-h{margin:0;font:500 44px/1.04 var(--display,"Cormorant Garamond",Georgia,serif);letter-spacing:-.01em;color:#F4F1EA;text-wrap:balance}
.bfp-h.it,.bfp-h i{font-style:italic}
.bfp-n{margin:0;font:500 124px/.86 var(--display,"Cormorant Garamond",Georgia,serif);color:#F4F1EA}
.bfp-n i{font-size:.46em;font-style:italic;vertical-align:.62em;margin-left:4px}
.bfp-p{margin:16px auto 0;font-size:15px;line-height:1.6;color:#C9CBBE;max-width:36ch}
.bfp-form{margin:20px auto 0;max-width:340px;display:grid;gap:10px}
.bfp .bfp-in{width:100%;box-sizing:border-box;height:52px;padding:0 16px;border:1px solid rgba(244,241,234,.55);background:transparent;color:#F4F1EA;font:400 15px/1 var(--sans,system-ui);text-align:center;border-radius:0}
.bfp .bfp-in::placeholder{color:#A9AD9B}
.bfp .bfp-in:focus{outline:none;border-color:#F4F1EA;background:rgba(244,241,234,.06)}
.bfp .bfp-btn{display:block;width:100%;box-sizing:border-box;margin:0;padding:18px 24px;border:0;background:#F4F1EA;color:#16170F!important;text-align:center;font:600 11.5px/1 var(--sans,system-ui);letter-spacing:.2em;text-transform:uppercase;text-decoration:none;cursor:pointer}
.bfp .bfp-btn:hover{background:#fff}
.bfp-err{margin:0;font-size:13px;color:#F1C7BE}
.bfp-code{display:flex;align-items:center;justify-content:center;gap:16px;margin:20px auto 12px;max-width:340px;padding:15px 16px;border:1px solid #F4F1EA;box-sizing:border-box}
.bfp-code b{font-size:18px;font-weight:600;letter-spacing:.16em}
.bfp-code button{border:0;background:none;padding:4px 2px;font:500 11px/1 var(--sans,system-ui);letter-spacing:.14em;text-transform:uppercase;text-decoration:underline;text-underline-offset:4px;color:#F4F1EA;cursor:pointer}
.bfp-rev .bfp-btn{max-width:340px;margin:0 auto}
.bfp-s{margin:14px auto 0;font-size:12px;line-height:1.55;color:#9DA190;max-width:40ch}
.bfp-s a{color:inherit}
.bfp-vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.bfp-v :focus-visible{outline:2px solid #F4F1EA;outline-offset:2px}
/* 1 */
.bfp1{width:min(470px,calc(100vw - 32px));padding:50px 40px 36px;box-sizing:border-box}
.bfp1 .bfp-h{font-size:36px;margin-top:2px}
/* 2 */
.bfp2{width:min(860px,calc(100vw - 32px));display:grid;grid-template-columns:5fr 6fr}
.bfp2-ph{background:#3A4129;min-height:500px}.bfp2-ph img{width:100%;height:100%;object-fit:cover;display:block}
.bfp2-tx{padding:52px 44px 36px;align-self:center}
/* 3 */
.bfp3{width:min(480px,calc(100vw - 32px))}
.bfp3-ph{display:block;width:100%;height:auto}
.bfp3-tx{padding:30px 40px 34px}
.bfp3 .bfp-h{font-size:38px}
/* 4 */
.bfp4{width:min(500px,calc(100vw - 32px));padding:14px;box-sizing:border-box}
.bfp4-in{border:1px solid rgba(244,241,234,.45);padding:38px 34px 30px}
.bfp4-amp{margin:0 0 6px;font:italic 500 64px/1 var(--display,"Cormorant Garamond",Georgia,serif);color:#C9CBBE}
.bfp-rule{width:44px;height:1px;background:rgba(244,241,234,.6);margin:20px auto 0}
/* 5 */
.bfp5{right:max(16px,env(safe-area-inset-right,0px));bottom:max(16px,env(safe-area-inset-bottom,0px));width:min(380px,calc(100vw - 32px));animation:bfp-in .4s ease both;text-align:left}
.bfp5-ph{display:block;width:100%;height:auto}
.bfp5-tx{padding:22px 24px 24px}
.bfp5 .bfp-h{font-size:30px}.bfp5 .bfp-p{margin-left:0;font-size:14px}
.bfp5 .bfp-form,.bfp5 .bfp-code,.bfp5 .bfp-rev .bfp-btn{max-width:none;margin-left:0;margin-right:0}
.bfp5 .bfp-in{text-align:left}.bfp5 .bfp-s{margin-left:0}
@media (max-width:700px){.bfp-h{font-size:36px}.bfp1{padding:46px 24px 28px}.bfp-n{font-size:100px}.bfp2{grid-template-columns:1fr}.bfp2-ph{min-height:0;height:200px}.bfp2-ph img{object-position:center 22%}.bfp2-tx{padding:28px 24px}.bfp3-tx{padding:26px 24px 28px}.bfp4-in{padding:30px 20px 24px}}
@media (prefers-reduced-motion:reduce){.bfp-v,.bfp-scrim{animation:none}}
</style>
<script>
(function () {
  var el = document.getElementById("bfp"); if (!el) return;
  var SEEN = "ah_bf_seen", DONE = "ah_bf_email", WAIT = "ah_bf_wait", BACK = "ah_bf_back";
  if (/\/challenge/.test(location.pathname)) return;                     /* never over Shopify's own check page */
  function get(n) { var x = new RegExp("(^|; )" + n + "=([^;]*)").exec(document.cookie); return x ? x[2] : ""; }
  function has(n) { return !!get(n); }
  function set(n, days, val) { document.cookie = n + "=" + (val || 1) + ";path=/;max-age=" + Math.round(days * 86400) + ";samesite=lax"; }
  /* If Shopify had to reload the page to save the email, we come back here: show the code straight away */
  var waiting = get(WAIT), posted = !!waiting;
  /* Shopify can send people to the homepage after its check: take them back to the page they were on */
  var back = get(BACK); if (back) { set(BACK, 0); try { back = decodeURIComponent(back); } catch (x) { back = ""; } }
  if (posted && back && back.charAt(0) === "/" && back.charAt(1) !== "/" && back.split("?")[0] !== location.pathname) { location.replace(back); return; }
  var m = /[?&]bf=([1-5])\b/.exec(location.search), preview = !!m, v = preview ? m[1] : (posted && /^[1-5]$/.test(waiting) ? waiting : el.getAttribute("data-live"));
  if (!v || v === "0") return;
  if (posted) { set(DONE, 30); set(WAIT, 0); }
  if (!preview && !posted && has(SEEN)) return;
  var card = el.querySelector('.bfp-v[data-v="' + v + '"]'); if (!card) return;
  var slot = card.querySelector(".bfp-slot"), gate = el.querySelector("[data-bfp-gate]"), rev = el.querySelector("[data-bfp-rev]");
  slot.appendChild(gate); slot.appendChild(rev);
  var form = document.getElementById("bfp-form"), email = document.getElementById("bfp-email"), err = el.querySelector(".bfp-err"), last = null;
  function reveal() { gate.hidden = true; rev.hidden = false; set(DONE, 30); }
  if (posted || (has(DONE) && !preview)) reveal();
  function close() { el.hidden = true; set(SEEN, 3); if (last && last.focus) last.focus(); }
  function open() {
    var ck = document.getElementById("ck");
    if (!preview && ck && !ck.hidden) { setTimeout(open, 1500); return; }   /* wait for the cookie choice first */
    el.classList.toggle("noscrim", card.hasAttribute("data-noscrim"));
    card.hidden = false; el.hidden = false; last = document.activeElement;
  }
  if (form) form.addEventListener("submit", function (e) {
    e.preventDefault();
    var val = (email.value || "").trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val)) { err.textContent = "Please enter a valid email address."; err.hidden = false; email.focus(); return; }
    err.hidden = true;
    var btn = form.querySelector(".bfp-btn"), label = btn.textContent; btn.textContent = "One moment…"; btn.disabled = true;
    function native() {
      set(WAIT, 0.02, v); set(BACK, 0.02, encodeURIComponent(location.pathname + location.search));
      var rt = form.querySelector('[name="return_to"]'); if (!rt) { rt = document.createElement("input"); rt.type = "hidden"; rt.name = "return_to"; form.appendChild(rt); }
      rt.value = location.pathname + location.search;
      form.submit();
      setTimeout(function () { set(WAIT, 0); set(BACK, 0); reveal(); btn.textContent = label; btn.disabled = false; }, 8000);   /* still here? never leave anyone waiting */
    }            /* Shopify asked for a check: submit normally, the code shows after the page reloads */
    fetch(form.getAttribute("action") || "/contact", { method: "POST", body: new FormData(form), headers: { Accept: "text/html" } })
      .then(function (r) { if (!r.ok || /challenge/.test(r.url)) { native(); return; } reveal(); btn.textContent = label; btn.disabled = false; })
      .catch(native);
  });
  el.addEventListener("click", function (e) {
    if (e.target.closest("[data-bfp-x]")) { close(); return; }
    var c = e.target.closest("[data-bfp-copy]");
    if (c) {
      var code = el.getAttribute("data-code"), l = c.textContent;
      var ok = function () { c.textContent = "Copied"; setTimeout(function () { c.textContent = l; }, 1800); };
      try { navigator.clipboard.writeText(code).then(ok, ok); } catch (x) { ok(); }
    }
    if (e.target.closest("a.bfp-btn")) set(SEEN, 3);
  });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !el.hidden) close(); });
  setTimeout(open, preview || posted ? 300 : 4000);
})();
</script>
