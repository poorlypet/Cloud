{%- capture mkbody -%}
<footer class="bf s5"><div class="su"><h2>Join the list <i>10% off your first order</i></h2><div>{%- form 'customer', class: 'f line' -%}<input type="hidden" name="contact[tags]" value="newsletter"><input id="em5" type="email" name="contact[email]" placeholder="Your email address" aria-label="Email address" autocomplete="email" required><button type="submit">Sign up</button>{%- if form.posted_successfully? -%}<p class="ah-ok">Thank you. Your code is on its way.</p>{%- endif -%}{%- endform -%}</div></div><div class="bk"><div class="cols"><div><h5>Axel &amp; Hound</h5><p class="about">Beautiful things for dogs, and the homes they share.</p></div><div><h5>Shop</h5><ul>{%- for link in linklists["footer-shop"].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul></div><div><h5>Help</h5><ul>{%- for link in linklists["footer-help"].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}{%- for link in linklists["footer-about"].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul></div><div><h5>Our brands</h5><ul>{%- for link in linklists["brands"].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul></div></div><div class="base"><span>&copy; {{ "now" | date: "%Y" }} Axel &amp; Hound, a trading name of Poorly Pet Ltd (company no. 17086223). Based in the UK.</span>{%- form 'localization', class: 'mk-loc mk-foot' -%}<label class="vh" for="mk-cf">Country</label><select id="mk-cf" name="country_code" onchange="this.form.submit()">{%- for c in localization.available_countries -%}{%- if c.iso_code == 'GB' and localization.country.iso_code != 'GB' -%}{%- continue -%}{%- endif -%}<option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }} {{ c.currency.symbol }})</option>{%- endfor -%}</select>{%- endform -%}<div class="pay" aria-label="Payment methods">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div><div class="legal">{%- for link in linklists["footer-legal"].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}<a href="#" role="button" data-cookie-settings>Cookie settings</a></div></div><span class="wm" aria-hidden="true">Axel <i>&amp;</i> Hound</span></div></footer>
{%- endcapture -%}{%- render 'mk-out', html: mkbody -%}
{% schema %}
{"name":"Footer"}
{% endschema %}
