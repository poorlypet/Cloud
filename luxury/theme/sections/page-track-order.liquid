<style>
/* K · Cormorant Garamond with Jost. Announcement bar, one-row header. Menus: capital text columns with a photograph flush right. Two buttons under the intro. */
:root{--display:"Cormorant Garamond",Georgia,serif;--sans:"Jost",system-ui,sans-serif}
.logo{font-size:32px;font-weight:600}
.nav{margin-left:clamp(36px,4vw,64px);gap:clamp(18px,2vw,30px)}
.hero-copy h1{font:600 clamp(38px,3.8vw,60px)/1.02 var(--display)}
.hide-d{display:none}
@media (max-width:1080px){.hide-d{display:inline-flex}}
.sp + .ws{padding-top:0}
.sp:has(+ .ws){padding-bottom:clamp(40px,4vw,56px)}
.bh + .sp-size{padding-top:0}
.sp-size + .pv-k{padding-top:0}
.sp-size:has(+ .pv-k){padding-bottom:clamp(40px,4vw,56px)}
.pv-k + .rv{padding-top:clamp(40px,4vw,56px)}
.pv-k + .bd2{padding-top:0}
.bd2 + .rv{padding-top:0}
.rv.r1 .cards{align-items:stretch}
.rv.r1 .cd{border-top:0;padding-top:0;display:flex;flex-direction:column;height:100%}
.rv.r1 .cd .rq{flex:1}
/* one rhythm: every section below the hero sits the same distance apart */
:root{--sec:clamp(56px,6vw,88px)}
main > section:not(.hero):not(.next){padding-top:0!important;padding-bottom:0!important;margin-top:var(--sec)!important;margin-bottom:0!important}
main > section.next{margin-top:var(--sec)}
</style>

<div class="ss tight"><section class="ss-hero short flush">{%- render 'ah-img', f: 'track-order-hero.jpg', eager: true -%}<div class="tx"><span class="ss-kick">Customer care</span><h1 class="ss-h1">Track an order</h1><p>See where your order is and follow its tracking.</p></div></section><section class="ss-nar" style="max-width:760px;margin-top:56px">{%- if customer -%}{%- if customer.orders.size > 0 -%}<div class="tk-list" style="display:grid;gap:28px">{%- for o in customer.orders limit: 20 -%}<div class="ss-order" style="margin:0"><div class="ss-oh"><div><span class="ss-kick">Order {{ o.name }} · {{ o.created_at | date: "%-d %B %Y" }} · {{ o.total_price | money_without_trailing_zeros }}</span><h3 class="ss-h3">{%- if o.cancelled -%}Cancelled{%- else -%}{{ o.fulfillment_status_label }}{%- endif -%}</h3><p class="ac-p">{%- for li in o.line_items limit: 3 -%}{{ li.product.title | default: li.title }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- if o.line_items.size > 3 -%} and {{ o.line_items.size | minus: 3 }} more{%- endif -%}</p></div><div class="ss-btns">{%- assign tk_seen = '' -%}{%- for li in o.line_items -%}{%- if li.fulfillment and li.fulfillment.tracking_url != blank -%}{%- unless tk_seen contains li.fulfillment.tracking_url -%}<a class="btn-k" href="{{ li.fulfillment.tracking_url }}" target="_blank" rel="noopener">Track parcel{% if li.fulfillment.tracking_company != blank %} with {{ li.fulfillment.tracking_company }}{% endif %}</a>{%- assign tk_seen = tk_seen | append: li.fulfillment.tracking_url | append: ' ' -%}{%- endunless -%}{%- endif -%}{%- endfor -%}<a class="btn-o" href="{{ o.order_status_url }}">Order status</a><a class="btn-o" href="{{ o.customer_url }}">View order</a></div></div></div>{%- endfor -%}</div>{%- else -%}<p class="ss-lead" style="text-align:center">You haven&rsquo;t placed an order with this account yet. If you checked out as a guest, your dispatch email has your tracking link.</p>{%- endif -%}{%- else -%}<p class="ss-lead" style="text-align:center">Your dispatch email has a tracking link that follows your parcel to your door. Or sign in with the email you ordered with to see the status and tracking of every order.</p><div class="ss-btns" style="justify-content:center;margin-top:28px"><a class="btn-k" href="{{ routes.account_login_url }}">Sign in to track</a><a class="btn-o" href="/pages/contact">Contact us</a></div>{%- endif -%}</section>
<section class="ss-tiles ss-end  ss-sec" style="--n:3"><a class="ss-tile" href="/pages/delivery">{%- render 'ah-img', f: 'track-order-tile-delivery.jpg', sizes: '(max-width: 800px) 100vw, 33vw' -%}<span class="ss-cap"><b>Delivery</b><span>Times, costs and options</span><em>Read more</em></span></a><a class="ss-tile" href="/pages/returns">{%- render 'ah-img', f: 'track-order-tile-returns.jpg', sizes: '(max-width: 800px) 100vw, 33vw' -%}<span class="ss-cap"><b>Returns</b><span>Within 14 days</span><em>Read more</em></span></a><a class="ss-tile" href="/pages/contact">{%- render 'ah-img', f: 'track-order-tile-contact-us.jpg', sizes: '(max-width: 800px) 100vw, 33vw' -%}<span class="ss-cap"><b>Contact us</b><span>We reply within a day</span><em>Get in touch</em></span></a></section></div>


{% schema %}
{
  "name": "Track an order",
  "tag": "div",
  "class": "ah-sec"
}
{% endschema %}
