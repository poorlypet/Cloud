

<div class="ss tight"><section class="ss-auth"><div class="card"><span class="ss-kick">Your account</span><h1 class="ss-h2">Activate your account</h1><p class="ss-lead" style="margin-top:12px">Choose a password to finish setting up your account.</p>{%- form 'activate_customer_password', class: 'v9-form ac-form' -%}{{ form.errors | default_errors }}<label class="f"><span>New password</span><input class="v9-in" type="password" name="customer[password]" autocomplete="new-password" placeholder="At least 8 characters" required></label><label class="f"><span>Confirm new password</span><input class="v9-in" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label><p class="v9-ferr" role="alert"></p><button type="submit" class="btn-k">Activate account</button>{%- endform -%}<div class="v9-sent" hidden></div></div></section></div>


{% schema %}
{
  "name": "Activate account",
  "tag": "div",
  "class": "ah-sec"
}
{% endschema %}
