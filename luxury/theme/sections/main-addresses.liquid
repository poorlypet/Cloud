

<div class="ss tight"><header class="ss-head"><span class="ss-kick">Your account</span><h1 class="ss-h1">Addresses</h1><p class=ss-lead>Where we send your orders.</p></header><nav class="ss-pnav" aria-label="Account"><a href="{{ routes.account_url }}"{% if template.name == 'customers/account' %} aria-current="page"{% endif %}>Overview</a><a href="{{ routes.account_url }}#orders">Orders</a><a href="{{ routes.account_addresses_url }}"{% if template.name == 'customers/addresses' %} aria-current="page"{% endif %}>Addresses</a><a href="{{ routes.account_logout_url }}">Sign out</a></nav><section class="ss-sec ss-nar" style="max-width:1000px"><div class="ss-addr">{%- for address in customer.addresses -%}<div class="a{% if address == customer.default_address %} def{% endif %}"><span class="ss-kick">{%- if address == customer.default_address -%}Default{%- else -%}Address{%- endif -%}</span><p>{{ address | format_address }}</p><div class="ac-ln"><a href="{{ routes.account_addresses_url }}?edit={{ address.id }}#new">Edit</a>{%- form 'customer_address', address, style: 'display:inline' -%}<input type="hidden" name="_method" value="delete"><button type="submit" class="zlink" style="background:none;border:0;padding:0;cursor:pointer">Remove</button>{%- endform -%}</div></div>{%- endfor -%}</div></section><section class="ss-sec ss-nar ss-c"><span class="ss-kick">New address</span><h2 class="ss-h3">Add an address</h2><div style="text-align:left">{%- form 'customer_address', customer.new_address, class: 'v9-form ac-form', id: 'new' -%}{{ form.errors | default_errors }}<div class="two"><label class="f"><span>First name</span><input class="v9-in" name="address[first_name]" required></label><label class="f"><span>Last name</span><input class="v9-in" name="address[last_name]" required></label></div><label class="f"><span>Address line 1</span><input class="v9-in" name="address[address1]" autocomplete="address-line1" required></label><label class="f"><span>Address line 2 (optional)</span><input class="v9-in" name="address[address2]" autocomplete="address-line2"></label><div class="two"><label class="f"><span>Town or city</span><input class="v9-in" name="address[city]" required></label><label class="f"><span>Postcode</span><input class="v9-in" name="address[zip]" required></label></div><input type="hidden" name="address[country]" value="United Kingdom"><label class="f"><span>Phone (optional)</span><input class="v9-in" type="tel" name="address[phone]"></label><label class="ac-check"><input type="checkbox" name="address[default]" value="1"><span>Make this my default address</span></label><button type="submit" class="btn-k">Save address</button>{%- endform -%}<div class="v9-sent" hidden></div></div></section></div>


{% schema %}
{
  "name": "Addresses",
  "tag": "div",
  "class": "ah-sec"
}
{% endschema %}
