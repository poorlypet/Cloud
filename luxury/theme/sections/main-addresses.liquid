

<div class="ss tight"><header class="ss-head"><span class="ss-kick">Your account</span><h1 class="ss-h1">Addresses</h1><p class=ss-lead>Where we send your orders.</p></header><nav class="ss-pnav" aria-label="Account"><a href="{{ routes.account_url }}"{% if template.name == 'customers/account' %} aria-current="page"{% endif %}>Overview</a><a href="{{ routes.account_url }}#orders">Orders</a><a href="{{ routes.account_addresses_url }}"{% if template.name == 'customers/addresses' %} aria-current="page"{% endif %}>Addresses</a><a href="{{ routes.account_logout_url }}">Sign out</a></nav><section class="ss-sec ss-nar" style="max-width:1000px"><div class="ss-addr">{%- for address in customer.addresses -%}<div class="a{% if address == customer.default_address %} def{% endif %}"><span class="ss-kick">{%- if address == customer.default_address -%}Default{%- else -%}Address{%- endif -%}</span><p>{{ address | format_address }}</p><div class="ac-ln"><a href="{{ routes.account_addresses_url }}?edit={{ address.id }}#new">Edit</a>{%- form 'customer_address', address, style: 'display:inline' -%}<input type="hidden" name="_method" value="delete"><button type="submit" class="zlink" style="background:none;border:0;padding:0;cursor:pointer">Remove</button>{%- endform -%}</div></div>{%- endfor -%}</div></section><section class="ss-sec ss-nar ss-c"><span class="ss-kick">New address</span><h2 class="ss-h3">Add an address</h2><div style="text-align:left">{%- form 'customer_address', customer.new_address, class: 'v9-form ac-form', id: 'new' -%}{{ form.errors | default_errors }}<div class="two"><label class="f"><span>First name</span><input class="v9-in" name="address[first_name]" required></label><label class="f"><span>Last name</span><input class="v9-in" name="address[last_name]" required></label></div><label class="f"><span>Address line 1</span><input class="v9-in" name="address[address1]" autocomplete="address-line1" required></label><label class="f"><span>Address line 2 (optional)</span><input class="v9-in" name="address[address2]" autocomplete="address-line2"></label><div class="two"><label class="f"><span>Town or city</span><input class="v9-in" name="address[city]" required></label><label class="f"><span>Postcode or ZIP</span><input class="v9-in" name="address[zip]" autocomplete="postal-code"></label></div><div class="two"><label class="f"><span>Country</span><select class="v9-in" id="ad-country" name="address[country]" data-default="{{ localization.country.name | escape }}" autocomplete="country">{{ all_country_option_tags }}</select></label><label class="f" id="ad-prov-w" hidden><span>State, province or region</span><select class="v9-in" id="ad-prov" name="address[province]" autocomplete="address-level1"></select></label></div><script>(function(){var c=document.getElementById("ad-country"),p=document.getElementById("ad-prov"),w=document.getElementById("ad-prov-w");if(!c)return;var d=c.getAttribute("data-default");for(var i=0;i<c.options.length;i++){if(c.options[i].value===d){c.selectedIndex=i;break;}}function fill(){var o=c.options[c.selectedIndex],l=[];try{l=JSON.parse(o.getAttribute("data-provinces")||"[]");}catch(e){}p.innerHTML="";l.forEach(function(x){var op=document.createElement("option");op.value=x[0];op.textContent=x[1];p.appendChild(op);});w.hidden=!l.length;p.disabled=!l.length;}c.addEventListener("change",fill);fill();})();</script><label class="f"><span>Phone (optional)</span><input class="v9-in" type="tel" name="address[phone]"></label><label class="ac-check"><input type="checkbox" name="address[default]" value="1"><span>Make this my default address</span></label><button type="submit" class="btn-k">Save address</button>{%- endform -%}<div class="v9-sent" hidden></div></div></section></div>


{% schema %}
{
  "name": "Addresses",
  "tag": "div",
  "class": "ah-sec"
}
{% endschema %}
