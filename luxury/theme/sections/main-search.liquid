{{ 'r48.css' | asset_url | stylesheet_tag }}
<style>
/* K · Cormorant Garamond with Jost. Announcement bar, one-row header. Menus: capital text columns with a photograph flush right. Two buttons under the intro. */
:root{--display:"Cormorant Garamond",Georgia,serif;--sans:"Jost",system-ui,sans-serif}
.logo{font-size:32px;font-weight:600}
.nav{margin-left:clamp(36px,4vw,64px);gap:clamp(18px,2vw,30px)}
.hero-copy h1{font:600 clamp(38px,3.8vw,60px)/1.02 var(--display)}
.hide-d{display:none}
@media (max-width:1080px){.hide-d{display:inline-flex}}
.sp + .ws{padding-top:0}
.sp:has(+ .ws){padding-bottom:clamp(40px,4vw,56px)}
.bh + .sp-size{padding-top:0}
.sp-size + .pv-k{padding-top:0}
.sp-size:has(+ .pv-k){padding-bottom:clamp(40px,4vw,56px)}
.pv-k + .rv{padding-top:clamp(40px,4vw,56px)}
.pv-k + .bd2{padding-top:0}
.bd2 + .rv{padding-top:0}
.rv.r1 .cards{align-items:stretch}
.rv.r1 .cd{border-top:0;padding-top:0;display:flex;flex-direction:column;height:100%}
.rv.r1 .cd .rq{flex:1}
/* one rhythm: every section below the hero sits the same distance apart */
:root{--sec:clamp(56px,6vw,88px)}
main > section:not(.hero):not(.next){padding-top:0!important;padding-bottom:0!important;margin-top:var(--sec)!important;margin-bottom:0!important}
main > section.next{margin-top:var(--sec)}
</style>

<div class="cx c1 sx"><nav class="crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span aria-current="page">Search</span></nav><div class="head"><h1 class="cx-t">{%- if search.performed -%}Results for <i>&ldquo;{{ search.terms | escape }}&rdquo;</i>{%- else -%}Search{%- endif -%}</h1><form class="sx-f" role="search" action="{{ routes.search_url }}" method="get"><input type="search" name="q" value="{{ search.terms | escape }}" aria-label="Search again"><input type="hidden" name="type" value="product"><button type="submit">Search again</button></form><nav class="cx-sub nr-try" aria-label="Popular searches"><span>Try</span><a href="{{ routes.search_url }}?q=Dachshund+coat&type=product">Dachshund coat</a><a href="{{ routes.search_url }}?q=Raincoat&type=product">Raincoat</a><a href="{{ routes.search_url }}?q=Bolster+bed&type=product">Bolster bed</a><a href="{{ routes.search_url }}?q=Leather+collar&type=product">Leather collar</a><a href="{{ routes.search_url }}?q=Stoneware+bowl&type=product">Stoneware bowl</a><a href="{{ routes.search_url }}?q=Gift+card&type=product">Gift card</a></nav></div>{%- if search.performed and search.results_count > 0 -%}<div class="cx-bar"><div class="l"><button type="button" class="cx-btn" data-filters><svg viewBox="0 0 14 14"><path d="M1 3h12M3 7h8M5 11h4"/></svg> Filter</button><span class="cx-count"></span><div class="cx-chips l"></div></div><label class="cx-sel"><span class="sr">Sort by</span><select class="cx-sort" id="sort11" aria-label="Sort by"><option value="feat">Most relevant</option><option value="low">Price, low to high</option><option value="high">Price, high to low</option></select></label></div>{%- paginate search.results by 48 -%}<div class="cx-grid">{%- for item in search.results -%}{%- if item.object_type == 'product' -%}{%- render 'card', product: item -%}{%- endif -%}{%- endfor -%}</div><div class="cx-more"><p>Showing {{ search.results.size }} of {{ search.results_count }} results</p>{%- if paginate.next -%}<a class="btn-o" href="{{ paginate.next.url }}" style="margin-top:16px">Load more</a>{%- endif -%}</div>{%- endpaginate -%}{%- else -%}<div class="nr-none"><h2>No products found</h2><p>We couldn&rsquo;t find anything for &ldquo;{{ search.terms | escape }}&rdquo;. Check the spelling, try a shorter word, or start from one of the searches above. Still stuck? <a href="/pages/contact">Ask us</a> and a real person will help.</p></div><div class="nr-like"><h2>You might like</h2><div class="cx-grid">{%- for product in collections['bestsellers'].products limit: 4 -%}{%- render 'card', product: product -%}{%- endfor -%}</div></div>{%- endif -%}</div><div class="fscrim"></div><aside class="fd" tabindex="-1" aria-label="Filters"><div class="fd-h"><h2>Filter</h2><button type="button" class="fd-x" data-fd-close>Close <svg viewBox="0 0 14 14"><path d="M1 1l12 12M13 1L1 13"/></svg></button></div><div class="fd-b"><details class="fg" open><summary>Size</summary><div class="opts sz"><label class="fs"><input type="checkbox" data-f="size" value="xs" data-label="Size XS" id="dszxs"><span>XS</span></label><label class="fs"><input type="checkbox" data-f="size" value="s" data-label="Size S" id="dszs"><span>S</span></label><label class="fs"><input type="checkbox" data-f="size" value="m" data-label="Size M" id="dszm"><span>M</span></label><label class="fs"><input type="checkbox" data-f="size" value="l" data-label="Size L" id="dszl"><span>L</span></label><label class="fs"><input type="checkbox" data-f="size" value="xl" data-label="Size XL" id="dszxl"><span>XL</span></label></div></details><details class="fg" open><summary>Fit</summary><div class="opts"><label class="fo"><input type="checkbox" data-f="fit" value="dachshund" data-label="Dachshund" id="dfdachshund">Dachshund</label><label class="fo"><input type="checkbox" data-f="fit" value="whippet" data-label="Whippet &amp; greyhound" id="dfwhippet">Whippet &amp; greyhound</label><label class="fo"><input type="checkbox" data-f="fit" value="standard" data-label="Standard fit" id="dfstandard">Standard fit</label></div></details><details class="fg"><summary>Colour</summary><div class="opts"><label class="fo"><input type="checkbox" data-f="colour" value="Black" data-label="Black" id="dc0"><span class="dot" style="background:#1C1C1C"></span>Black</label><label class="fo"><input type="checkbox" data-f="colour" value="Dark-Olive" data-label="Dark Olive" id="dc1"><span class="dot" style="background:#4B5139"></span>Dark Olive</label><label class="fo"><input type="checkbox" data-f="colour" value="Camo" data-label="Camo" id="dc2"><span class="dot" style="background:#7C7A4E"></span>Camo</label><label class="fo"><input type="checkbox" data-f="colour" value="Plum" data-label="Plum" id="dc3"><span class="dot" style="background:#5B2D3A"></span>Plum</label><label class="fo"><input type="checkbox" data-f="colour" value="Navy" data-label="Navy" id="dc4"><span class="dot" style="background:#1F2A3C"></span>Navy</label><label class="fo"><input type="checkbox" data-f="colour" value="Cream" data-label="Cream" id="dc5"><span class="dot" style="background:#EDE6DA"></span>Cream</label><label class="fo"><input type="checkbox" data-f="colour" value="Forest" data-label="Forest" id="dc6"><span class="dot" style="background:#2F4A3A"></span>Forest</label><label class="fo"><input type="checkbox" data-f="colour" value="Tobacco" data-label="Tobacco" id="dc7"><span class="dot" style="background:#7A5232"></span>Tobacco</label></div></details><details class="fg"><summary>Price</summary><div class="opts"><label class="fo"><input type="checkbox" data-f="price" value="0-50" data-label="Under £50" id="dp0">Under £50</label><label class="fo"><input type="checkbox" data-f="price" value="50-100" data-label="£50 to £100" id="dp1">£50 to £100</label><label class="fo"><input type="checkbox" data-f="price" value="100-999" data-label="Over £100" id="dp2">Over £100</label><label class="fo"><input type="checkbox" data-f="sale" value="1" data-label="On sale" id="dsale">On sale</label></div></details></div><div class="fd-f"><button type="button" class="btn-o" data-clear>Clear all</button><button type="button" class="btn-k" data-fd-close>Show <span class="cx-count"></span></button></div></aside>


