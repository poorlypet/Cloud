<style>
/* K · Cormorant Garamond with Jost. Announcement bar, one-row header. Menus: capital text columns with a photograph flush right. Two buttons under the intro. */
:root{--display:"Cormorant Garamond",Georgia,serif;--sans:"Jost",system-ui,sans-serif}
.logo{font-size:32px;font-weight:600}
.nav{margin-left:clamp(36px,4vw,64px);gap:clamp(18px,2vw,30px)}
.hero-copy h1{font:600 clamp(38px,3.8vw,60px)/1.02 var(--display)}
.hide-d{display:none}
@media (max-width:1080px){.hide-d{display:inline-flex}}
.sp + .ws{padding-top:0}
.sp:has(+ .ws){padding-bottom:clamp(40px,4vw,56px)}
.bh + .sp-size{padding-top:0}
.sp-size + .pv-k{padding-top:0}
.sp-size:has(+ .pv-k){padding-bottom:clamp(40px,4vw,56px)}
.pv-k + .rv{padding-top:clamp(40px,4vw,56px)}
.pv-k + .bd2{padding-top:0}
.bd2 + .rv{padding-top:0}
.rv.r1 .cards{align-items:stretch}
.rv.r1 .cd{border-top:0;padding-top:0;display:flex;flex-direction:column;height:100%}
.rv.r1 .cd .rq{flex:1}
/* one rhythm: every section below the hero sits the same distance apart */
:root{--sec:clamp(56px,6vw,88px)}
main > section:not(.hero):not(.next){padding-top:0!important;padding-bottom:0!important;margin-top:var(--sec)!important;margin-bottom:0!important}
main > section.next{margin-top:var(--sec)}
</style>
{{ 'r49.css' | asset_url | stylesheet_tag }}
<div class="dw">
  <header class="dw-hero"><div class="dw-w"><nav class="dz-crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span aria-current="page">{{ page.title }}</span></nav><h1>{{ page.title }}</h1><p>{{ section.settings.intro }}</p></div></header>
  <section class="hb-sec"><div class="dw-w">
    <div class="hb-boxes">
      {%- for link in linklists[section.settings.menu].links -%}
        {%- assign c = link.object -%}
        <a href="{{ link.url }}">
          {%- if c.metafields.custom.origin.value != blank -%}<i class="brd-o">{{ c.metafields.custom.origin.value }}</i>{%- endif -%}
          <b>{{ link.title }}</b>
          {%- if c.metafields.custom.tagline.value != blank -%}<span>{{ c.metafields.custom.tagline.value }}</span>{%- endif -%}
          <em>Shop {{ link.title }}</em>
        </a>
      {%- endfor -%}
    </div>
  </div></section>
  <section class="hb-sec hb-ct"><div class="dw-w hb-two"><div><h2>Makers we work with</h2><p>{{ section.settings.outro }}</p></div><div class="hb-cd"><a class="dw-btn" href="/pages/our-story">Our story</a></div></div></section>
</div>
<style>.brd-o{font-style:normal;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink2)}.hb-boxes a{min-height:230px}</style>
{% schema %}
{
  "name": "Brands",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Brands menu", "default": "main-menu" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Independent makers from across Europe, chosen slowly and lived with at home before we stock them." },
    { "type": "textarea", "id": "outro", "label": "Closing text", "default": "We visit our makers, buy in small runs and stay for years, not seasons. New brands join only when we would happily use what they make ourselves." }
  ]
}
{% endschema %}
