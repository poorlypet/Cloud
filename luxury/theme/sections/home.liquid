<style>
/* K · Cormorant Garamond with Jost. Announcement bar, one-row header. Menus: capital text columns with a photograph flush right. Two buttons under the intro. */
:root{--display:"Cormorant Garamond",Georgia,serif;--sans:"Jost",system-ui,sans-serif}
.logo{font-size:32px;font-weight:600}
.nav{margin-left:clamp(36px,4vw,64px);gap:clamp(18px,2vw,30px)}
.hero-copy h1{font:600 clamp(38px,3.8vw,60px)/1.02 var(--display)}
.hide-d{display:none}
@media (max-width:1080px){.hide-d{display:inline-flex}}
.sp + .ws{padding-top:0}
.sp:has(+ .ws){padding-bottom:clamp(40px,4vw,56px)}
.bh + .sp-size{padding-top:0}
.sp-size + .pv-k{padding-top:0}
.sp-size:has(+ .pv-k){padding-bottom:clamp(40px,4vw,56px)}
.pv-k + .rv{padding-top:clamp(40px,4vw,56px)}
.pv-k + .bd2{padding-top:0}
.bd2 + .rv{padding-top:0}
.rv.r1 .cards{align-items:stretch}
.rv.r1 .cd{border-top:0;padding-top:0;display:flex;flex-direction:column;height:100%}
.rv.r1 .cd .rq{flex:1}
/* one rhythm: every section below the hero sits the same distance apart */
:root{--sec:clamp(56px,6vw,88px)}
main > section:not(.hero):not(.next){padding-top:0!important;padding-bottom:0!important;margin-top:var(--sec)!important;margin-bottom:0!important}
main > section.next{margin-top:var(--sec)}
</style>

  <section class="hero" aria-label="Welcome to Axel &amp; Hound">
    {%- render 'ah-vid', f: 'home-hero.mp4' -%}
    <div class="hero-shade"></div><div class="hero-top"></div>
    <div class="hero-copy">
      <p class="eyebrow">Axel &amp; Hound</p>
      <h1>Beautiful things for dogs, and the homes they share.</h1>
      <div class="btns"><a class="sqbtn" href="#">Shop new in <svg viewBox="0 0 16 10"><path d="M0 5h15M11 1l4 4-4 4"/></svg></a><a class="sqbtn ghost" href="#">Winter Sale</a></div>
    </div>
    <div class="usp usp-over" aria-label="Why shop with us">
      <div class="usp-in">
        <a class="u tp" href="#" aria-label="Rated excellent on Trustpilot"><span class="tp-stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i class="half"></i></span><span>Rated excellent</span></a>
        <div class="u"><span>Free delivery over £100</span></div>
        <div class="u"><span>Free 14-day returns</span></div>
        <div class="u"><span>Based in the UK</span></div>
      </div>
    </div>
  </section>
  <section class="sp" aria-label="Shop by category">
    <div class="sp-h"><h2>Shop by category</h2><a class="all" href="#">Shop all <svg class="a" viewBox="0 0 16 10"><path d="M0 5h15M11 1l4 4-4 4"/></svg></a></div><div class="g sq"><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-category-sleeping.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Sleeping</span></a><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-category-walking.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Walking</span></a><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-category-clothing.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Clothing</span></a><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-category-dining.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Dining</span></a><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-category-playing.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Playing</span></a><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-category-travelling.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Travelling</span></a></div>
  </section>
  <section class="ws w1" aria-label="Winter Sale">
    <div class="hx hx1"><h2>Winter Sale <i>up to 30% off</i></h2><a class="all" href="#">Shop the sale <svg class="a" viewBox="0 0 16 10"><path d="M0 5h15M11 1l4 4-4 4"/></svg></a></div><div class="g4">{%- for product in collections['sale'].products limit: 4 -%}{%- render 'card', product: product -%}{%- endfor -%}</div>
  </section>
  <section class="bh v2" aria-label="Cloud7"><div class="vid">{%- render 'ah-vid', f: 'home-cloud7.mp4' -%}<div class="ov"><span class="k">The brand edit</span><h2>Cloud7</h2><p>Cloud7 is a Berlin label making coats, beds and accessories for dogs. Every piece is designed to be lived in: warm on cold walks, easy to wash, and good-looking enough for the city.</p><a class="lk" href="#">Discover Cloud7 <svg class="a" viewBox="0 0 16 10"><path d="M0 5h15M11 1l4 4-4 4"/></svg></a></div></div><div class="prods"><div class="prods-h"><h3>Shop Cloud7</h3><a href="#">View all <svg class="a" viewBox="0 0 16 10"><path d="M0 5h15M11 1l4 4-4 4"/></svg></a></div><div class="g4">{%- for product in collections['new-in'].products limit: 4 -%}{%- render 'card', product: product -%}{%- endfor -%}</div></div></section>
  <section class="sp sp-size" aria-label="Shop by size">
    <div class="sp-h"><h2>Shop by size</h2><a class="all" href="#">Size guide <svg class="a" viewBox="0 0 16 10"><path d="M0 5h15M11 1l4 4-4 4"/></svg></a></div><div class="g sq"><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-size-puppy.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Puppy</span></a><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-size-petite.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Petite</span></a><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-size-small.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Small</span></a><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-size-medium.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Medium</span></a><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-size-large.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Large</span></a><a href="#"><span class="ph">{%- render 'ah-img', f: 'home-size-giant.jpg', sizes: '(max-width: 640px) 50vw, 17vw' -%}</span><span class="n-serif">Giant</span></a></div>
  </section>
  <section class="pv v3 pv-k" aria-label="New puppy"><div class="pv-h"><h2>New puppy <i>for the first months home</i></h2><a class="lk" href="#">Shop puppy <svg class="a" viewBox="0 0 16 10"><path d="M0 5h15M11 1l4 4-4 4"/></svg></a></div><div class="row"><div class="film">{%- render 'ah-vid', f: 'home-new-puppy.mp4' -%}</div>{%- for product in collections['new-in'].products limit: 2 -%}{%- render 'card', product: product -%}{%- endfor -%}</div></section>
  <section class="rv tpw soft" aria-label="Customer reviews">
    <div class="in"><div class="tsum"><b>Excellent</b><span class="tps big" aria-label="Rated 4.8 out of 5"><i></i><i></i><i></i><i></i><i class="half"></i></span><div class="tbased">Based on <a href="#">1,240 reviews</a></div><img class="tlogo-img" src="{{ 'trustpilot.png' | asset_url }}" alt="Trustpilot" width="100" height="25"></div><div class="tcar"><div class="trvs"><div class="tr"><div class="ttop"><span class="tps" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><a class="vf" href="#">Verified</a></div><span class="tby"><b>Christopher S.,</b> 3 days ago</span><h4>Beautiful quality</h4><p>The bouclé bed is even nicer in person, and Biscuit has barely left it.</p></div><div class="tr"><div class="ttop"><span class="tps" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><a class="vf" href="#">Verified</a></div><span class="tby"><b>Arthur C.,</b> 3 days ago</span><h4>Perfect fit for our dachshund</h4><p>Long enough in the back and easy to wash.</p></div><div class="tr"><div class="ttop"><span class="tps" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><a class="vf" href="#">Verified</a></div><span class="tby"><b>Morley S.,</b> 4 days ago</span><h4>Delivered the next day</h4><p>Lovely packaging and the coat is beautifully made.</p></div><div class="tr"><div class="ttop"><span class="tps" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><a class="vf" href="#">Verified</a></div><span class="tby"><b>Rob,</b> 5 days ago</span><h4>Quality of materials</h4><p>Quality of materials, design and solid stitching.</p></div><div class="tr"><div class="ttop"><span class="tps" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><a class="vf" href="#">Verified</a></div><span class="tby"><b>Hannah W.,</b> 1 week ago</span><h4>Lovely to deal with</h4><p>Helpful with sizing and quick to reply.</p></div><div class="tr"><div class="ttop"><span class="tps" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><a class="vf" href="#">Verified</a></div><span class="tby"><b>Emma L.,</b> 1 week ago</span><h4>Gift for my sister</h4><p>Wrapped beautifully with a handwritten card.</p></div></div><div class="tctl"><div class="tarr"><button type="button" class="tprev" aria-label="Previous reviews"><svg viewBox="0 0 8 12"><path d="M7 1L2 6l5 5"/></svg></button><button type="button" class="tnext" aria-label="More reviews"><svg viewBox="0 0 8 12"><path d="M1 1l5 5-5 5"/></svg></button></div></div></div></div>
  </section>
  <section class="bd2" aria-label="Dachshund and greyhound">
    <div class="bd2-h"><h2>Long backs, deep chests <i>cut to fit</i></h2><p>Dachshunds and greyhounds need a different shape. These coats, harnesses and beds are cut for a long back or a deep chest and slim waist, so they fit properly and stay put.</p></div><div class="two"><a class="pan" href="#">{%- render 'ah-img', f: 'home-dachshund.jpg', sizes: '(max-width: 800px) 100vw, 50vw' -%}<span class="tx"><b>Dachshund</b><small>Coats and harnesses with a longer back.</small><span class="lk">Shop dachshund <svg class="a" viewBox="0 0 16 10"><path d="M0 5h15M11 1l4 4-4 4"/></svg></span></span></a><a class="pan" href="#">{%- render 'ah-img', f: 'home-greyhound-whippet.jpg', sizes: '(max-width: 800px) 100vw, 50vw' -%}<span class="tx"><b>Greyhound &amp; whippet</b><small>Deep-chested coats that stay put on a slim waist.</small><span class="lk">Shop greyhound <svg class="a" viewBox="0 0 16 10"><path d="M0 5h15M11 1l4 4-4 4"/></svg></span></span></a></div>
  </section>
  <section class="hdg v1" aria-label="Happy dogs"><div class="hdg-h"><div><h2>Happy dogs <i>at home with Axel &amp; Hound</i></h2></div><a class="lk" href="#">Share yours on Instagram <svg class="a" viewBox="0 0 16 10"><path d="M0 5h15M11 1l4 4-4 4"/></svg></a></div><div class="g"><div><div class="vt">{%- render 'ah-vid', f: 'happy-dogs-juno.mp4', hover: true -%}</div><span class="cap">Juno<small>border collie</small></span></div><div><div class="vt">{%- render 'ah-vid', f: 'happy-dogs-fig.mp4', hover: true -%}</div><span class="cap">Fig<small>dachshund puppy</small></span></div><div><div class="vt">{%- render 'ah-vid', f: 'happy-dogs-bonnie.mp4', hover: true -%}</div><span class="cap">Bonnie<small>rough collie</small></span></div><div><div class="vt">{%- render 'ah-vid', f: 'happy-dogs-ted.mp4', hover: true -%}</div><span class="cap">Ted<small>border collie</small></span></div></div></section>


