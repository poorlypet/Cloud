<style>
/* K · Cormorant Garamond with Jost. Announcement bar, one-row header. Menus: capital text columns with a photograph flush right. Two buttons under the intro. */
:root{--display:"Cormorant Garamond",Georgia,serif;--sans:"Jost",system-ui,sans-serif}
.logo{font-size:32px;font-weight:600}
.nav{margin-left:clamp(36px,4vw,64px);gap:clamp(18px,2vw,30px)}
.hero-copy h1{font:600 clamp(38px,3.8vw,60px)/1.02 var(--display)}
.hide-d{display:none}
@media (max-width:1080px){.hide-d{display:inline-flex}}
.sp + .ws{padding-top:0}
.sp:has(+ .ws){padding-bottom:clamp(40px,4vw,56px)}
.bh + .sp-size{padding-top:0}
.sp-size + .pv-k{padding-top:0}
.sp-size:has(+ .pv-k){padding-bottom:clamp(40px,4vw,56px)}
.pv-k + .rv{padding-top:clamp(40px,4vw,56px)}
.pv-k + .bd2{padding-top:0}
.bd2 + .rv{padding-top:0}
.rv.r1 .cards{align-items:stretch}
.rv.r1 .cd{border-top:0;padding-top:0;display:flex;flex-direction:column;height:100%}
.rv.r1 .cd .rq{flex:1}
/* one rhythm: every section below the hero sits the same distance apart */
:root{--sec:clamp(56px,6vw,88px)}
main > section:not(.hero):not(.next){padding-top:0!important;padding-bottom:0!important;margin-top:var(--sec)!important;margin-bottom:0!important}
main > section.next{margin-top:var(--sec)}
</style>

