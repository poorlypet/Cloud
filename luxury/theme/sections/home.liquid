<style>
  .cs .cs-w{position:relative;margin-top:28px;margin-right:calc(var(--gut,24px) * -1)}
  .cs-r{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100vw - 2 * var(--gut,24px) - 30px) / 3.25);gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain;padding-right:var(--gut,24px);scroll-padding-left:0}
  .cs-r::-webkit-scrollbar{display:none}
  .cs-r:focus-visible{outline:2px solid var(--olive,#5E6B3A);outline-offset:4px}
  .cs-t{position:relative;display:block;aspect-ratio:4/5;overflow:hidden;background:#EDEDEB;scroll-snap-align:start;color:#fff}
  .cs-t img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .9s cubic-bezier(.2,.7,.2,1)}
  .cs-t:hover img{transform:scale(1.035)}
  .cs-t::after{content:"";position:absolute;inset:auto 0 0;height:38%;background:linear-gradient(transparent,rgba(0,0,0,.32));pointer-events:none}
  .cs-t:has(img.ah-blank)::after{display:none}
  .cs-l{position:absolute;left:22px;bottom:20px;z-index:1;font:600 12px/1.2 var(--sans);letter-spacing:.2em;text-transform:uppercase}
  .cs-t:has(img.ah-blank) .cs-l{color:var(--ink,#161616)}
  .cs-a{position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:46px!important;height:46px!important;min-width:0!important;min-height:0!important;padding:0!important;margin:0!important;border-radius:50%;border:0;background:#fff;box-shadow:0 2px 14px rgba(0,0,0,.12);display:grid;place-items:center;cursor:pointer}
  .cs-a{display:flex!important;align-items:center;justify-content:center}
  .cs-a[hidden]{display:none!important}
  .cs-a svg{display:block;margin:0 auto;flex:none}
  .cs-a svg{width:8px;height:14px;fill:none;stroke:#161616;stroke-width:1.4}
  .cs-a.prev{left:-23px} .cs-a.next{right:24px}
  .mq{margin-top:clamp(36px,4vw,52px);border-top:1px solid #E4E4E0;border-bottom:1px solid #E4E4E0;overflow:hidden;margin-left:calc(var(--gut,24px) * -1);margin-right:calc(var(--gut,24px) * -1)}
  .mq-t{display:flex;width:max-content;animation:mq 46s linear infinite}
  .mq:hover .mq-t{animation-play-state:paused}
  .mq-g{display:flex;align-items:center;flex:none}
  .mq-i{font:600 12px/1 var(--sans);letter-spacing:.22em;text-transform:uppercase;padding:20px 0;white-space:nowrap;color:var(--ink,#161616)}
  .mq-d{color:var(--olive,#5E6B3A);font-size:11px;padding:0 clamp(36px,4vw,64px)}
  @keyframes mq{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.mq-t{animation:none}}
  @media (max-width:800px){.cs-r{grid-auto-columns:78vw}.cs-a{display:none}.cs-l{left:16px;bottom:16px;font-size:11px}.mq-i{font-size:11px;padding:16px 0}}
</style>
<script>
(function(){var w=document.currentScript.previousElementSibling.previousElementSibling.querySelector('.cs-w');if(!w)return;
var r=w.querySelector('.cs-r'),p=w.querySelector('.prev'),n=w.querySelector('.next');
function step(){var t=r.querySelector('.cs-t');return t?t.getBoundingClientRect().width+10:300}
function upd(){p.hidden=r.scrollLeft<8;n.hidden=r.scrollLeft+r.clientWidth>=r.scrollWidth-8}
p.addEventListener('click',function(){r.scrollBy({left:-step(),behavior:'smooth'})});
n.addEventListener('click',function(){r.scrollBy({left:step(),behavior:'smooth'})});
r.addEventListener('scroll',upd,{passive:true});window.addEventListener('resize',upd);upd();})();
</script>
