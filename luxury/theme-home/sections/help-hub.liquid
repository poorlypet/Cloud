<div class="phead--band">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span aria-current="page">{{ page.title }}</span></nav>
    <header class="phead"><h1 class="h1">{{ section.settings.heading | default: page.title }}</h1><p class="lead">{{ section.settings.intro }}</p></header>
  </div>
</div>
<div class="wrap" style="padding-bottom:clamp(56px,6vw,96px)">
  <div class="hub">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span><em>Read more</em></a>
    {%- endfor -%}
  </div>
  {%- if page.content != blank -%}<div class="rte" style="max-width:820px;margin:clamp(48px,5vw,72px) auto 0">{{ page.content }}</div>{%- endif -%}
  <div class="sec--linen" style="margin-top:clamp(48px,5vw,72px);padding:clamp(32px,4vw,56px);display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
    <div><h2 class="h2">Still need help?</h2><p class="lead" style="margin:8px 0 0">A real person replies to every message within one working day, Monday to Friday.</p></div>
    <a class="btn" href="/pages/contact">Contact us</a>
  </div>
</div>
{% schema %}
{
  "name": "Help hub",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How can we help?" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Everything you need to know about ordering, delivery, returns and looking after your things." }
  ],
  "blocks": [ { "type": "topic", "name": "Topic", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Delivery" },
    { "type": "text", "id": "text", "label": "Text", "default": "Costs, times and worldwide shipping." },
    { "type": "url", "id": "link", "label": "Link" }
  ] } ]
}
{% endschema %}
