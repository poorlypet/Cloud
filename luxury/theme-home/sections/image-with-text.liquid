<section class="{% if section.settings.linen %}sec--linen{% endif %}">
  <div class="split{% if section.settings.flip %} split--rev{% endif %}">
    <div class="split-m">{% render 'media', image: section.settings.image, ratio: section.settings.ratio, sizes: '(max-width: 1000px) 100vw, 50vw', ph: 'lifestyle-2' %}</div>
    <div class="split-tx rv">
      {%- if section.settings.kicker != blank -%}<span class="eyebrow">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="h2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="lead">{{ section.settings.text }}</div>
      {%- if section.settings.button != blank -%}<a class="btn btn--line" href="{{ section.settings.link }}">{{ section.settings.button }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "ratio", "label": "Shape", "default": "r-4x5", "options": [ { "value": "r-4x5", "label": "Portrait" }, { "value": "r-1x1", "label": "Square" }, { "value": "r-3x2", "label": "Landscape" } ] },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false },
    { "type": "checkbox", "id": "linen", "label": "Soft background", "default": true },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Our makers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made by people who care about the detail" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We work directly with small workshops across Europe, from Cloud7 in Berlin to weavers on the Danish coast. Every piece is chosen slowly and lived with at home first.</p>" },
    { "type": "text", "id": "button", "label": "Button", "default": "Our story" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
