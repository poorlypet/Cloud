<div class="phead--band"><div class="wrap"><header class="phead"><span class="eyebrow">The journal</span><h1 class="h1" style="margin-top:12px">{{ blog.title }}</h1></header></div></div>
<div class="wrap" style="padding-bottom:clamp(56px,6vw,96px)">{%- paginate blog.articles by 12 -%}<div class="posts">{%- for article in blog.articles -%}<a class="post" href="{{ article.url }}">{% render 'media', image: article.image, ratio: 'r-3x2', sizes: '(max-width: 1000px) 100vw, 33vw', ph: 'lifestyle-1' %}<time>{{ article.published_at | date: '%-d %B %Y' }}</time><h2 class="h3">{{ article.title }}</h2>{%- if article.excerpt != blank -%}<p class="muted" style="margin:0">{{ article.excerpt | strip_html | truncatewords: 24 }}</p>{%- endif -%}</a>{%- else -%}<p class="lead" style="grid-column:1/-1;text-align:center">Our first stories are on their way.</p>{%- endfor -%}</div>
{%- if paginate.next -%}<div style="text-align:center;margin-top:48px"><a class="btn btn--line" href="{{ paginate.next.url }}">More stories</a></div>{%- endif -%}{%- endpaginate -%}</div>
{% schema %}{ "name": "Journal" }{% endschema %}