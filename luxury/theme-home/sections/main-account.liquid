<div class="wrap" style="padding-bottom:clamp(56px,6vw,96px)"><header class="phead" style="text-align:left"><span class="eyebrow">Your account</span><h1 class="h1" style="margin-top:12px">Hello, {{ customer.first_name | default: 'there' }}</h1></header><nav class="tabs-acc"><a href="{{ routes.account_url }}"{% if template.name == 'customers/account' %} aria-current="page"{% endif %}>Orders</a><a href="{{ routes.account_addresses_url }}"{% if template.name == 'customers/addresses' %} aria-current="page"{% endif %}>Addresses</a><a href="{{ routes.account_logout_url }}">Sign out</a></nav>
{%- paginate customer.orders by 20 -%}{%- if customer.orders.size > 0 -%}<table class="orders"><thead><tr><th>Order</th><th>Date</th><th>Status</th><th style="text-align:right">Total</th></tr></thead><tbody>{%- for order in customer.orders -%}<tr><td><a href="{{ order.customer_url }}" style="text-decoration:underline;text-underline-offset:3px">{{ order.name }}</a></td><td>{{ order.created_at | date: '%-d %b %Y' }}</td><td>{{ order.fulfillment_status_label }}</td><td style="text-align:right">{{ order.total_price | money }}</td></tr>{%- endfor -%}</tbody></table>{%- else -%}<div class="empty"><p class="h3">You haven&rsquo;t placed an order yet</p><a class="btn" href="{{ routes.collections_url }}/new-in" style="margin-top:16px">Shop new in</a></div>{%- endif -%}{%- endpaginate -%}</div>
{% schema %}{ "name": "Account" }{% endschema %}