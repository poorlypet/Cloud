<section class="sec sec--linen news">
  <div class="wrap rv" style="max-width:720px">
    <span class="eyebrow">{{ section.settings.kicker }}</span>
    <h2 class="h2" style="margin-top:12px">{{ section.settings.heading }}</h2>
    <p class="lead" style="margin:14px auto 0">{{ section.settings.text }}</p>
    {%- form 'customer', id: 'news-sec' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr" for="news-email">Email address</label>
      <input id="news-email" type="email" name="contact[email]" placeholder="Your email address" autocomplete="email" required>
      <button type="submit">Sign up</button>
      {%- if form.posted_successfully? -%}<p class="form-ok">Thank you. Your welcome code is on its way.</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "10% off your first order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New pieces, care guides and the occasional good dog. No more than twice a month." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
