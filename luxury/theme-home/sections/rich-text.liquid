<section class="sec{% if section.settings.linen %} sec--linen{% endif %}">
  <div class="wrap rv" style="max-width:860px;text-align:{{ section.settings.align }}">
    {%- if section.settings.kicker != blank -%}<span class="eyebrow">{{ section.settings.kicker }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2" style="margin-top:12px">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="lead" style="margin-top:16px">{{ section.settings.text }}</div>
    {%- if section.settings.button != blank -%}<a class="link" href="{{ section.settings.link }}" style="display:inline-block;margin-top:18px">{{ section.settings.button }}</a>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fewer things, chosen well" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We don&rsquo;t stock everything. We stock the bed we&rsquo;d choose, the coat that survives a muddy winter and the bowl that looks right on a kitchen floor.</p>" },
    { "type": "text", "id": "button", "label": "Link text" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [ { "value": "center", "label": "Centre" }, { "value": "left", "label": "Left" } ] },
    { "type": "checkbox", "id": "linen", "label": "Soft background", "default": false }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
