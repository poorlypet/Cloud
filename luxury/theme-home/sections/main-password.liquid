<div style="min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 20px;background:var(--linen)">{% render 'logo' %}<p class="lead" style="max-width:480px;margin:28px auto 0">{{ shop.password_message | default: "We&rsquo;re opening soon. Leave your email and we&rsquo;ll tell you first, with 10% off your first order." }}</p>
<div class="news" style="width:100%">{%- form 'customer' -%}<input type="hidden" name="contact[tags]" value="newsletter,prelaunch"><label class="sr" for="pw-e">Email</label><input id="pw-e" type="email" name="contact[email]" placeholder="Your email address" required><button type="submit">Notify me</button>{%- if form.posted_successfully? -%}<p class="form-ok">Thank you. We&rsquo;ll be in touch.</p>{%- endif -%}{%- endform -%}</div>
<details style="margin-top:48px;font-size:13px"><summary style="cursor:pointer">Store owner? Enter the password</summary><div class="news">{%- form 'storefront_password' -%}<label class="sr" for="pw-p">Password</label><input id="pw-p" type="password" name="password" placeholder="Password"><button type="submit">Enter</button>{%- endform -%}</div></details></div>
{% schema %}{ "name": "Password" }{% endschema %}