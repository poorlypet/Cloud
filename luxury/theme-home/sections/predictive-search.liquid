{%- if predictive_search.performed -%}
  {%- assign ps = predictive_search.resources.products -%}
  {%- assign cs = predictive_search.resources.collections -%}
  {%- assign pg = predictive_search.resources.pages -%}
  {%- if ps.size > 0 or cs.size > 0 or pg.size > 0 -%}
    {%- if cs.size > 0 or pg.size > 0 -%}
      <span class="eyebrow">Suggestions</span>
      <div class="srch-pop" style="margin-bottom:28px">
        {%- for c in cs -%}<a class="chip" href="{{ c.url }}">{{ c.title }}</a>{%- endfor -%}
        {%- for p in pg -%}<a class="chip" href="{{ p.url }}">{{ p.title }}</a>{%- endfor -%}
      </div>
    {%- endif -%}
    {%- if ps.size > 0 -%}
      <div class="sec-h" style="margin-bottom:20px"><span class="eyebrow">Products</span><a class="link" href="{{ routes.search_url }}?type=product&q={{ predictive_search.terms | url_encode }}">See all results</a></div>
      <div class="grid">{%- for product in ps limit: 4 -%}{% render 'card', product: product %}{%- endfor -%}</div>
    {%- endif -%}
  {%- else -%}
    <p class="lead">Nothing matches &ldquo;{{ predictive_search.terms | escape }}&rdquo; yet. Try a material or a category, such as wool or beds.</p>
  {%- endif -%}
{%- endif -%}
