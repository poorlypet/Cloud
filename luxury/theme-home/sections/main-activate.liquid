<div class="wrap"><div class="auth"><h1 class="h1">Activate your account</h1><p class="lead">Choose a password for your account.</p>{%- form 'activate_customer_password', class: 'form' -%}{%- if form.errors -%}<div class="form-err">{{ form.errors | default_errors }}</div>{%- endif -%}<label class="field"><span>Password</span><input type="password" name="customer[password]" autocomplete="new-password" required></label><label class="field"><span>Confirm password</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label><button class="btn btn--full" type="submit">Activate account</button>{%- endform -%}</div></div>
{% schema %}{ "name": "Activate your account" }{% endschema %}