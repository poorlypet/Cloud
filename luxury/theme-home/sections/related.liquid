<section class="sec" data-related>
  <div class="wrap">
    <div class="sec-h"><div><span class="eyebrow">{{ section.settings.kicker }}</span><h2 class="h2" style="margin-top:10px">{{ section.settings.heading }}</h2></div></div>
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="grid">{%- for product in recommendations.products limit: 4 -%}{% render 'card', product: product %}{%- endfor -%}</div>
    {%- else -%}
      {%- assign c = product.collections.first -%}
      <div class="grid">{%- for item in c.products limit: 5 -%}{%- unless item.id == product.id -%}{% render 'card', product: item %}{%- endunless -%}{%- endfor -%}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "You may also like", "settings": [ { "type": "text", "id": "kicker", "label": "Small heading", "default": "Pairs well with" }, { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" } ] }
{% endschema %}
