<div class="wrap">
  <header class="phead">
    <span class="eyebrow">Search</span>
    <h1 class="h1" style="margin-top:12px">{%- if search.performed -%}{% if search.results_count > 0 %}Results for{% else %}Nothing found for{% endif %} <span class="serif-i">&ldquo;{{ search.terms | escape }}&rdquo;</span>{%- else -%}What are you looking for?{%- endif -%}</h1>
    <form action="{{ routes.search_url }}" method="get" class="news" style="text-align:left"><input type="hidden" name="type" value="product">
      <div style="display:flex;max-width:560px;margin:24px auto 0;border-bottom:1px solid var(--ink)"><label class="sr" for="sq2">Search</label><input id="sq2" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search Axel &amp; Hound" style="flex:1;border:0;outline:0;height:52px;font-size:16px;background:none;min-width:0"><button type="submit" class="link" style="border:0">Search</button></div>
    </form>
    <div class="srch-pop" style="justify-content:center;margin-top:18px">{%- assign pops = settings.popular_searches | split: ',' -%}{%- for t in pops -%}<a class="chip" href="{{ routes.search_url }}?type=product&q={{ t | strip | url_encode }}">{{ t | strip }}</a>{%- endfor -%}</div>
  </header>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count > 0 -%}
        <div class="toolbar" style="position:static"><span class="count">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }}</span></div>
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{% render 'card', product: item %}
            {%- else -%}<a class="card" href="{{ item.url }}"><div class="card-m">{% render 'media', ratio: 'r-4x5', ph: 'lifestyle-1' %}</div><div class="card-t"><span class="card-v">{{ item.object_type | capitalize }}</span><span class="card-n">{{ item.title }}</span></div></a>{%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.next -%}<div style="text-align:center;margin-top:48px"><a class="btn btn--line" href="{{ paginate.next.url }}">Load more</a></div>{%- endif -%}
      {%- else -%}
        <div class="empty" style="padding-top:24px"><p class="lead">Check the spelling, try a shorter word, or start from one of the searches above. Still stuck? <a href="/pages/contact" style="text-decoration:underline;text-underline-offset:3px;color:var(--ink)">Ask us</a> and a real person will help.</p></div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
  <div style="height:clamp(32px,4vw,64px)"></div>
</div>
{% schema %}{ "name": "Search" }{% endschema %}
