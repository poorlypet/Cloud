{%- liquid
  assign help_pages = 'help,delivery,returns,faqs,track-order,contact,privacy-policy,terms-and-conditions,cookie-policy,accessibility' | split: ','
  assign in_help = false
  if help_pages contains page.handle
    assign in_help = true
  endif
-%}
<div class="phead--band">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span>{%- if in_help and page.handle != 'help' -%}<a href="/pages/help">Help</a><span>/</span>{%- endif -%}<span aria-current="page">{{ page.title }}</span></nav>
    <header class="phead"><h1 class="h1">{{ page.title }}</h1>{%- if section.settings.intro != blank -%}<p class="lead">{{ section.settings.intro }}</p>{%- endif -%}</header>
  </div>
</div>
<div class="wrap">
  {%- if in_help -%}
    <div class="page-grid">
      <nav class="side-nav" aria-label="Help">
        {%- for link in linklists['footer-help'].links -%}<a href="{{ link.url }}"{% if link.url == page.url %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- endfor -%}
        {%- for link in linklists['footer-legal'].links -%}<a href="{{ link.url }}"{% if link.url == page.url %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- endfor -%}
      </nav>
      <div class="rte" style="max-width:820px">{{ page.content }}</div>
    </div>
  {%- else -%}
    <div class="rte" style="max-width:820px;margin:0 auto;padding-bottom:clamp(56px,6vw,96px)">{{ page.content }}</div>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Page", "settings": [ { "type": "textarea", "id": "intro", "label": "Introduction" } ] }
{% endschema %}
