{%- assign c = section.settings.collection -%}
<section class="sec{% if section.settings.linen %} sec--linen{% endif %}">
  <div class="wrap">
    <div class="sec-h rv">
      <div><span class="eyebrow">{{ section.settings.kicker }}</span><h2 class="h2" style="margin-top:10px">{{ section.settings.heading | default: c.title }}</h2>{%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}</div>
      {%- if c != blank -%}<a class="link" href="{{ c.url }}">Shop all</a>{%- endif -%}
    </div>
    <div class="grid rv">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.count -%}{% render 'card', product: product %}{%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}<div class="card"><div class="card-m">{% render 'media', ratio: 'r-4x5', ph: 'product-1' %}</div><div class="card-t"><span class="card-v">Coming soon</span><span class="card-n">New pieces are on their way</span></div></div>{%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Just in" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "range", "id": "count", "label": "Products", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "checkbox", "id": "linen", "label": "Soft background", "default": false }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
