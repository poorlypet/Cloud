<section class="sec--tight">
  <div class="wrap"><div class="usps" style="--cols:{{ section.blocks.size }}">
    {%- for block in section.blocks -%}<div class="usp" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>{%- endfor -%}
  </div></div>
</section>
{% schema %}
{
  "name": "Promises",
  "max_blocks": 4,
  "blocks": [ { "type": "usp", "name": "Promise", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Complimentary delivery" },
    { "type": "text", "id": "text", "label": "Text", "default": "On UK orders over £75" }
  ] } ],
  "presets": [ { "name": "Promises", "blocks": [ { "type": "usp" }, { "type": "usp" }, { "type": "usp" }, { "type": "usp" } ] } ]
}
{% endschema %}
