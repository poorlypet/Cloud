<div class="wrap"><div class="auth"><h1 class="h1">Create an account</h1><p class="lead">Track orders, save addresses and check out faster.</p>
{%- form 'create_customer', class: 'form' -%}{%- if form.errors -%}<div class="form-err">{{ form.errors | default_errors }}</div>{%- endif -%}<div class="two"><label class="field"><span>First name</span><input name="customer[first_name]" autocomplete="given-name" required></label><label class="field"><span>Last name</span><input name="customer[last_name]" autocomplete="family-name" required></label></div><label class="field"><span>Email</span><input type="email" name="customer[email]" autocomplete="email" required></label><label class="field"><span>Password</span><input type="password" name="customer[password]" autocomplete="new-password" required></label><label class="check"><input type="checkbox" name="customer[accepts_marketing]"> Email me new pieces and 10% off my first order</label><button class="btn btn--full" type="submit">Create account</button>{%- endform -%}
<p class="alt">Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a></p></div></div>
{% schema %}{ "name": "Create account" }{% endschema %}