<section class="banner{% if section.settings.image == blank %} no-media sec--linen{% endif %}">
  {%- if section.settings.image != blank -%}{% render 'media', image: section.settings.image, sizes: '100vw' %}{%- endif -%}
  <div class="banner-tx rv">
    {%- if section.settings.kicker != blank -%}<span class="eyebrow" style="color:inherit">{{ section.settings.kicker }}</span>{%- endif -%}
    <h2 class="h1" style="color:inherit;margin-top:12px">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button != blank -%}<a class="btn {% if section.settings.image != blank %}btn--light{% endif %}" href="{{ section.settings.link }}">{{ section.settings.button }}</a>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "The winter edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Warm beds for long evenings" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Deep bolsters in bouclé and wool, made to be slept in and washed." },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop beds" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [ { "name": "Banner" } ]
}
{% endschema %}
