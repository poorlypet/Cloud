<div class="wrap" style="padding-bottom:clamp(56px,6vw,96px)"><header class="phead" style="text-align:left"><span class="eyebrow">Your account</span><h1 class="h1" style="margin-top:12px">Addresses</h1></header><nav class="tabs-acc"><a href="{{ routes.account_url }}"{% if template.name == 'customers/account' %} aria-current="page"{% endif %}>Orders</a><a href="{{ routes.account_addresses_url }}"{% if template.name == 'customers/addresses' %} aria-current="page"{% endif %}>Addresses</a><a href="{{ routes.account_logout_url }}">Sign out</a></nav>
<div class="addr">{%- for address in customer.addresses -%}<div><span class="eyebrow">{% if address == customer.default_address %}Default{% else %}Address{% endif %}</span><p style="margin:12px 0 16px;color:var(--ink-2)">{{ address | format_address }}</p>{%- form 'customer_address', address -%}<input type="hidden" name="_method" value="delete"><button class="line-r" type="submit">Remove</button>{%- endform -%}</div>{%- endfor -%}</div>
<div style="max-width:620px;margin-top:48px"><h2 class="h2" style="margin-bottom:20px">Add an address</h2>{%- form 'customer_address', customer.new_address, class: 'form' -%}{%- if form.errors -%}<div class="form-err">{{ form.errors | default_errors }}</div>{%- endif -%}<div class="two"><label class="field"><span>First name</span><input name="address[first_name]" required></label><label class="field"><span>Last name</span><input name="address[last_name]" required></label></div><label class="field"><span>Address</span><input name="address[address1]" autocomplete="address-line1" required></label><label class="field"><span>Address line 2</span><input name="address[address2]" autocomplete="address-line2"></label><div class="two"><label class="field"><span>Town or city</span><input name="address[city]" required></label><label class="field"><span>Postcode</span><input name="address[zip]" required></label></div><label class="field"><span>Country</span><select name="address[country]">{{ all_country_option_tags }}</select></label><label class="field"><span>Phone</span><input type="tel" name="address[phone]"></label><label class="check"><input type="checkbox" name="address[default]" value="1"> Make this my default address</label><button class="btn" type="submit" style="align-self:flex-start">Save address</button>{%- endform -%}</div></div>
{% schema %}{ "name": "Addresses" }{% endschema %}