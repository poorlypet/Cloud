<div class="wrap" style="padding-bottom:clamp(56px,6vw,96px)"><nav class="crumbs"><a href="{{ routes.account_url }}">Account</a><span>/</span><span aria-current="page">{{ order.name }}</span></nav><header class="phead" style="text-align:left"><h1 class="h1">Order {{ order.name }}</h1><p class="lead" style="margin:10px 0 0">Placed {{ order.created_at | date: '%-d %B %Y' }} &middot; {{ order.fulfillment_status_label }}</p></header>
<div class="cart"><div>{%- for li in order.line_items -%}<div class="line"><div>{% render 'media', image: li.image, ratio: 'r-4x5', sizes: '110px', ph: 'product-1' %}</div><div><span class="line-n">{{ li.product.title | default: li.title }}</span>{%- if li.variant_title != blank -%}<div class="line-o">{{ li.variant_title }}</div>{%- endif -%}<div class="line-o">Quantity {{ li.quantity }}</div>{%- for f in li.fulfillment.tracking_urls -%}<a class="link" href="{{ f }}" style="display:inline-block;margin-top:12px">Track parcel</a>{%- endfor -%}</div><div class="line-p">{{ li.final_line_price | money }}</div></div>{%- endfor -%}</div>
<aside class="summ"><h2>Summary</h2><dl><div><dt>Subtotal</dt><dd>{{ order.line_items_subtotal_price | money }}</dd></div>{%- for s in order.shipping_methods -%}<div><dt>{{ s.title }}</dt><dd>{{ s.price | money }}</dd></div>{%- endfor -%}<div><dt>VAT included</dt><dd>{{ order.tax_price | money }}</dd></div><div class="tot"><dt>Total</dt><dd>{{ order.total_price | money }}</dd></div></dl>
{%- if order.shipping_address -%}<p class="note" style="margin-top:20px"><b style="color:var(--ink)">Delivering to</b><br>{{ order.shipping_address | format_address }}</p>{%- endif -%}<a class="btn btn--line btn--full" href="/pages/returns">Start a return</a></aside></div></div>
{% schema %}{ "name": "Order" }{% endschema %}