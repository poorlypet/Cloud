<aside class="drawer left" id="menu-drawer" aria-label="Menu" tabindex="-1">
  <div class="drawer-h"><h2>Menu</h2><button class="x" type="button" data-close>Close</button></div>
  <div class="drawer-b">
    <ul class="m-nav">
      {%- for link in linklists['main-menu'].links -%}
        <li>
          {%- if link.links.size > 0 -%}
            <details><summary>{{ link.title }}</summary>
              <ul><li><a href="{{ link.url }}">Shop all {{ link.title | downcase }}</a></li>{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}</ul>
            </details>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <div class="m-util">
      {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">{% if customer %}Your account{% else %}Sign in{% endif %}</a>{%- endif -%}
      <a href="/pages/help">Help</a>
      <a href="/pages/delivery">Delivery</a>
      <a href="/pages/contact">Contact us</a>
    </div>
  </div>
</aside>
