<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="canonical" href="{{ canonical_url }}">
{{ content_for_header }}
<title>{% if template.name == 'index' %}Poorly Pet. UK pet health, recovery and mobility specialist{% elsif page_title contains 'Poorly Pet' %}{{ page_title }}{% else %}{{ page_title }} | Poorly Pet{% endif %}</title>
{% render 'seo-head' %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Domine:wght@400;700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ 'home.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'card.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'fix-site.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'pet.css' | asset_url }}">
{% if page_css != blank %}{% assign _css = page_css | split: ',' %}{% for f in _css %}<link rel="stylesheet" href="{{ f | strip | asset_url }}">
{% endfor %}{% endif %}
<script>window.THEME_LIVE=true;window.SHOP_ROUTES={cart:'{{ routes.cart_url }}',search:'{{ routes.search_url }}',account:'{{ routes.account_url }}',login:'{{ routes.account_login_url }}',logout:'{{ routes.account_logout_url }}'};</script>
<!-- dog / cat split: what this page is about, read by pet.js to decide which pet to show -->
<script>window.PP_CTX={tmpl:{{ request.page_type | json }}{% case request.page_type %}{% when 'product' %},handle:{{ product.handle | json }},title:{{ product.title | json }},type:{{ product.type | json }},tags:{{ product.tags | json }}{% when 'collection' %},handle:{{ collection.handle | json }},title:{{ collection.title | json }},tags:[]{% when 'article' %},handle:{{ article.handle | json }},title:{{ article.title | json }},tags:{{ article.tags | json }}{% when 'page' %},handle:{{ page.handle | json }},title:{{ page.title | json }},tags:[]{% else %},handle:"",title:"",tags:[]{% endcase %}};</script>
<script src="{{ 'pet.js' | asset_url }}"></script>
</head>
<body class="{{ body_class }}">

<a class="sr" href="#main">Skip to content</a>

<!-- utility bar: deep teal, three items spread edge to edge, a dropdown at the right end -->
<div class="util on-teal" id="util">
  <div class="wrap">
    <span class="ui show" id="ui0"></span>
    <span class="ui" id="ui1"></span>
    <span class="ui" id="ui2"></span>
  </div>
</div>

<!-- desktop header: wordmark lozenge, search at half width, icon-over-label actions -->
<header class="hdr on-teal" id="hdr">
  <div class="wrap">
    <a class="wm" href="/" aria-label="Poorly Pet home"><img src="{{ 'logo-on-teal.png' | asset_url }}" alt="Poorly Pet" width="1140" height="312"></a>
    <div class="search on-white" id="search">
      <form role="search" action="/search" method="get" autocomplete="off">
        <label class="sr" for="q">Search a condition, a symptom or a product</label>
        <input id="q" name="q" type="search" placeholder="Search a condition, a symptom or a product" aria-expanded="false" aria-controls="sdrop" aria-autocomplete="list" data-drop="sdrop">
        <button class="sbtn" type="submit" aria-label="Search"><span class="mag" aria-hidden="true"></span></button>
      </form>
      <div class="sdrop" id="sdrop" role="listbox" aria-label="Search suggestions"></div>
    </div>
    <div class="acts">
      <button class="act" id="account-btn" type="button" aria-controls="account" aria-expanded="false"><span class="ic ic-user" aria-hidden="true"></span><span class="lbl">Sign in</span></button>
      <button class="act" id="club-btn" type="button" aria-controls="clubdrawer" aria-expanded="false"><span class="ic ic-club" aria-hidden="true">PP</span><span class="lbl">Club</span></button>
      <button class="act" id="basket-btn" type="button" aria-controls="basket" aria-expanded="false"><span class="ic ic-bag" aria-hidden="true"></span><span class="lbl">Basket</span><span class="cnt" data-n="0" data-count>0</span></button>
    </div>
  </div>
</header>

<!-- nav row: the four mega menus render into the list from PP.content.nav -->
<nav class="dnav on-teal" id="dnav" aria-label="Shop">
  <div class="wrap"><ul id="navlist"></ul></div>
</nav>

<!-- mobile header (below 1024): hamburger, wordmark, search icon, basket -->
<header class="mhdr on-teal" id="mhdr">
  <div class="wrap">
    <button class="ib burger" id="burger" type="button" aria-label="Open menu" aria-controls="drawer" aria-expanded="false"><i aria-hidden="true"></i></button>
    <a class="wm" href="/" aria-label="Poorly Pet home"><img src="{{ 'logo-on-teal.png' | asset_url }}" alt="Poorly Pet" width="1140" height="312"></a>
    <div class="macts">
      <button class="ib" id="msearch-btn" type="button" aria-label="Search" aria-controls="msearch" aria-expanded="false"><span class="mag" aria-hidden="true"></span></button>
      <button class="ib" id="mbasket-btn" type="button" aria-label="Basket" aria-controls="basket" aria-expanded="false"><span class="ic ic-bag" aria-hidden="true"></span><span class="cnt" data-n="0" data-count>0</span></button>
    </div>
  </div>
</header>

<!-- the mobile search bar slides down under the header -->
<div class="msearch on-white" id="msearch">
  <div class="search">
    <form role="search" action="/search" method="get" autocomplete="off">
      <span class="mag" aria-hidden="true" style="color:var(--teal)"></span>
      <label class="sr" for="mq">Search a condition, a symptom or a product</label>
      <input id="mq" name="q" type="search" placeholder="Search a symptom or a product" aria-expanded="false" aria-controls="msdrop" aria-autocomplete="list" data-drop="msdrop">
      <button class="mx" id="msearch-x" type="button" aria-label="Close search">&times;</button>
    </form>
    <div class="sdrop" id="msdrop" role="listbox" aria-label="Search suggestions"></div>
  </div>
</div>


{{ content_for_layout }}


<!-- the footer -->
<template id="pay-icons">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'payi' }}{% endfor %}</template>
<footer class="foot" id="foot"></footer>

<!-- scrim behind every drawer -->
<div class="scrim" id="scrim"></div>

<!-- full screen menu drawer with three sliding panels -->
<div class="drawer on-white" id="drawer" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
  <div class="dtop on-teal">
    <button class="x" type="button" data-close aria-label="Close menu">&times;</button>
    <a class="wm" href="/" aria-label="Poorly Pet home"><img src="{{ 'logo-on-teal.png' | asset_url }}" alt="Poorly Pet" width="1140" height="312"></a>
    <button class="tb" type="button" data-open="account">Sign in</button>
    <button class="tb" type="button" data-open="basket">Basket</button>
  </div>
  <div class="dview">
    <div class="dtrack" id="dtrack" data-i="0">
      <div class="dp" id="dp0"></div>
      <div class="dp" id="dp1"></div>
      <div class="dp" id="dp2"></div>
    </div>
  </div>
</div>

<!-- account drawer -->
<aside class="sd on-white" id="account" role="dialog" aria-modal="true" aria-labelledby="account-h" aria-hidden="true">
  <div class="sdh on-teal"><h2 id="account-h">Your account</h2><button class="x" type="button" data-close aria-label="Close">&times;</button></div>
  <div class="sdb" id="account-body"></div>
</aside>

<!-- Poorly Pet Club drawer -->
<aside class="sd on-white" id="clubdrawer" role="dialog" aria-modal="true" aria-labelledby="club-h" aria-hidden="true">
  <div class="sdh on-teal"><h2 id="club-h">Poorly Pet Club</h2><button class="x" type="button" data-close aria-label="Close">&times;</button></div>
  <div class="sdb" id="club-body"></div>
</aside>

<!-- basket drawer -->
<aside class="sd on-white" id="basket" role="dialog" aria-modal="true" aria-labelledby="basket-h" aria-hidden="true">
  <div class="sdh on-teal"><h2 id="basket-h">Your basket</h2><button class="x" type="button" data-close aria-label="Close">&times;</button></div>
  <div class="sdb" id="basket-body">
    <div id="basket-lines"></div>
    <div id="basket-with"></div>
    <div id="basket-sum"></div>
  </div>
</aside>


<script src="{{ 'data.js' | asset_url }}"></script>
<script src="{{ 'condcats.js' | asset_url }}"></script>
<script src="{{ 'shopify-data.js' | asset_url }}"></script>
<script src="{{ 'site-config.js' | asset_url }}"></script>
<script src="{{ 'pet-cat-products.js' | asset_url }}"></script>
<script src="{{ 'pet-cat.js' | asset_url }}"></script>
<script src="{{ 'site-data.js' | asset_url }}"></script>
<script src="{{ 'pet-ai-cat.js' | asset_url }}"></script>
{% render 'live-shop' %}
{% if template.name == 'index' %}{% render 'live-home-reviews' %}{% endif %}
{% if page.handle == 'reviews' %}{% render 'live-reviews' %}{% render 'judgeme-form-any' %}{% endif %}
{% render 'newsletter-form' %}
<script src="{{ 'live.js' | asset_url }}"></script>
<script src="{{ 'offers.js' | asset_url }}"></script>
<script src="{{ 'card.js' | asset_url }}"></script>
<script src="{{ 'page-live.js' | asset_url }}"></script>
<script src="{{ 'photos.js' | asset_url }}"></script>
<script src="{{ 'photos-cat.js' | asset_url }}"></script>
<script src="{{ 'photo-slots.js' | asset_url }}"></script>
<script src="{{ 'club-off.js' | asset_url }}"></script>
<script src="{{ 'no-dash.js' | asset_url }}"></script>
<script src="{{ 'home.js' | asset_url }}" defer></script>
<script src="{{ 'site.js' | asset_url }}" defer></script>
<script src="{{ 'hero-variants.js' | asset_url }}" defer></script>

{% if page_js != blank %}{% assign _js = page_js | split: ',' %}{% for f in _js %}<script src="{{ f | strip | asset_url }}"></script>
{% endfor %}{% endif %}
</body>
</html>
